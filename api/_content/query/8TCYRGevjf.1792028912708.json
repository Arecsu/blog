":"li","props":{},"children":[{"type":"text","value":"Cuchillo para rallar el chocolate"}]}]}]}]},{"type":"element","tag":"recipe-process","props":{":process":"true"},"children":[{"type":"element","tag":"h3","props":{"id":"buttermilk"},"children":[{"type":"text","value":"Buttermilk"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"Mezclar la leche entera con el jugo de limón o vinagre. Dejar reposar 10-15 minutos hasta que se corte levemente. Reservar."}]},{"type":"element","tag":"h3","props":{"id":"salsa-de-frutos-rojos"},"children":[{"type":"text","value":"Salsa de frutos rojos"}]},{"type":"element","tag":"ol","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Calentar en una olla los frutos rojos congelados junto con el azúcar, revolviendo de tanto en tanto."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Cocinar hasta que los frutos se deshagan y se forme una salsa homogénea."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Colar la preparación, separando el líquido (jugo) de la parte sólida."}]}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"De este colado se obtienen dos cosas: el "},{"type":"element","tag":"strong","props":{},"children":[{"type":"text","value":"jugo"}]},{"type":"text","value":", que se usa para el bizcochuelo y como almíbar de armado, y la "},{"type":"element","tag":"strong","props":{},"children":[{"type":"text","value":"fruta colada"}]},{"type":"text","value":", que se usa como relleno entre capas. Si sobra jugo, se puede guardar para servir a un costado de cada porción."}]},{"type":"element","tag":"h3","props":{"id":"bizcochuelo"},"children":[{"type":"text","value":"Bizcochuelo"}]},{"type":"element","tag":"ol","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Precalentar el horno a 180°C."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"En un bowl, tamizar juntos la harina, el cacao, el bicarbonato y la sal."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"En otro bowl, batir la manteca con el azúcar hasta que quede cremosa."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Agregar los huevos de a uno, batiendo bien después de cada uno, y luego la esencia de vainilla."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Incorporar los secos tamizados alternando con el buttermilk y los 120 gr de jugo de frutos rojos, en 3 tandas, empezando y terminando con los secos. Mezclar solo hasta integrar."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Dividir la masa en 3 moldes iguales (o cocinar en tandas con un mismo molde)."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Hornear 20-25 minutos, o hasta que un palillo salga limpio."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Dejar enfriar por completo antes de armar."}]}]},{"type":"element","tag":"h3","props":{"id":"chantilly-de-cacao-relleno-y-cobertura"},"children":[{"type":"text","value":"Chantilly de cacao (relleno y cobertura)"}]},{"type":"element","tag":"ol","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Batir la crema de leche bien fría con el azúcar impalpable y el cacao hasta llegar a picos suaves-medios."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Agregar el licor de almendras y chocolate, y seguir batiendo hasta lograr picos firmes. No pasarse de batido."}]}]},{"type":"element","tag":"h3","props":{"id":"chantilly-blanca-decoración"},"children":[{"type":"text","value":"Chantilly blanca (decoración)"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"Batir la crema de leche con el azúcar y la esencia de vainilla hasta lograr picos firmes. Reservar en frío hasta el armado final."}]},{"type":"element","tag":"h3","props":{"id":"chocolate-rallado"},"children":[{"type":"text","value":"Chocolate rallado"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"Con un cuchillo, rallar el chocolate semiamargo (frío o congelado) en ángulo de 45-60°, generando virutas tipo aserrín. Reservar en frío."}]},{"type":"element","tag":"h3","props":{"id":"armado"},"children":[{"type":"text","value":"Armado"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"Con un tenedor, pinchar suavemente toda la superficie de cada capa de bizcochuelo y humedecer con el jugo de frutos rojos."}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"Desde la base hacia arriba:"}]},{"type":"element","tag":"ol","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Capa de bizcochuelo (base) → humedecer"}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Chantilly de cacao"}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Salsa de frutos rojos (la parte sólida colada)"}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Capa de bizcochuelo → humedecer"}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Chantilly de cacao"}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Salsa de frutos rojos"}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Capa de bizcochuelo (tapa) → humedecer"}]}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"Cubrir toda la torta (parte superior y laterales) con el resto de la chantilly de cacao."}]},{"type":"element","tag":"h3","props":{"id":"decoración-final"},"children":[{"type":"text","value":"Decoración final"}]},{"type":"element","tag":"ol","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Esparcir el chocolate rallado sobre toda la cobertura de la torta."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Con la chantilly blanca, formar 8 picos en círculo sobre el borde superior de la torta."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Coronar cada pico con una cereza al marraschino."}]}]}]}],"toc":{"title":"","searchDepth":2,"depth":2,"links":[{"id":"buttermilk","depth":3,"text":"Buttermilk"},{"id":"salsa-de-frutos-rojos","depth":3,"text":"Salsa de frutos rojos"},{"id":"bizcochuelo","depth":3,"text":"Bizcochuelo"},{"id":"chantilly-de-cacao-relleno-y-cobertura","depth":3,"text":"Chantilly de cacao (relleno y cobertura)"},{"id":"chantilly-blanca-decoración","depth":3,"text":"Chantilly blanca (decoración)"},{"id":"chocolate-rallado","depth":3,"text":"Chocolate rallado"},{"id":"armado","depth":3,"text":"Armado"},{"id":"decoración-final","depth":3,"text":"Decoración final"}]}},"_type":"markdown","_id":"content:recetas:portal-cake.md","_source":"content","_file":"recetas/portal-cake.md","_stem":"recetas/portal-cake","_extension":"md"}