ext":" Sal"}]}]},{"id":"relleno","label":"Relleno","items":[{"id":"dulce-de-leche","label":"Dulce de leche repostero","quantity":800,"unit":"g","note":"aprox."}]},{"id":"merengue-italiano","label":"Merengue italiano","items":[{"id":"italian-whites","label":"Claras","quantity":3,"whole":true,"labelParts":[{"emoji":{"alt":"🥚","src":"data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2232%22 height=%2232%22 fill=%22none%22 viewBox=%220 0 32 32%22%3E%3Cpath fill=%22%23F3AD61%22 d=%22M16.331 2c-2.57 0-4.98 1.28-6.42 3.4l-.13.19A21.923 21.923 0 0 0 6.101 20l.08.8c.5 5.21 4.88 9.18 10.11 9.18 5.25 0 9.63-3.99 10.11-9.22l.09-.93a21.9 21.9 0 0 0-3.78-14.48A7.772 7.772 0 0 0 16.331 2Z%22/%3E%3C/svg%3E"}},{"text":" Claras"}]},{"id":"italian-sugar","label":"Azúcar","quantity":180,"unit":"g"},{"id":"italian-water","label":"Agua","quantity":50,"unit":"g"}]},{"id":"merengue-miel-de-cana","label":"Merengue Miel de caña","items":[{"id":"cane-whites","label":"Claras","quantity":3,"whole":true,"labelParts":[{"emoji":{"alt":"🥚","src":"data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2232%22 height=%2232%22 fill=%22none%22 viewBox=%220 0 32 32%22%3E%3Cpath fill=%22%23F3AD61%22 d=%22M16.331 2c-2.57 0-4.98 1.28-6.42 3.4l-.13.19A21.923 21.923 0 0 0 6.101 20l.08.8c.5 5.21 4.88 9.18 10.11 9.18 5.25 0 9.63-3.99 10.11-9.22l.09-.93a21.9 21.9 0 0 0-3.78-14.48A7.772 7.772 0 0 0 16.331 2Z%22/%3E%3C/svg%3E"}},{"text":" Claras"}]},{"id":"cane-sugar","label":"Azúcar","quantity":120,"unit":"g"},{"id":"cane-honey","label":"Miel de caña","quantity":72,"unit":"g"},{"id":"cane-water","label":"Agua","quantity":50,"unit":"g"}]}],"body":{"type":"root","children":[{"type":"element","tag":"recipe-ingredients","props":{},"children":[]},{"type":"element","tag":"recipe-process","props":{":process":"true"},"children":[{"type":"element","tag":"p","props":{},"children":[{"type":"element","tag":"strong","props":{},"children":[{"type":"text","value":"Rinde:"}]},{"type":"text","value":" 1 torta de 8 capas de 22 cm de diámetro."}]},{"type":"element","tag":"h3","props":{"id":"masa"},"children":[{"type":"text","value":"Masa"}]},{"type":"element","tag":"ol","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Tostar "},{"type":"element","tag":"recipe-amount","props":{"ingredient":"anise"},"children":[{"type":"text","value":"las semillas de anís"}]},{"type":"text","value":" en una sartén seca a fuego bajo, moviéndolas para que no se quemen. Cuando desprendan aroma, retirarlas y triturarlas."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Derretir "},{"type":"element","tag":"recipe-amount","props":{"ingredient":"butter"},"children":[{"type":"text","value":"la manteca"}]},{"type":"text","value":" y dejarla entibiar. Mezclarla con "},{"type":"element","tag":"recipe-amount","props":{"ingredient":"water"},"children":[{"type":"text","value":"el agua"}]},{"type":"text","value":" y "},{"type":"element","tag":"recipe-amount","props":{"ingredient":"yolks"},"children":[{"type":"text","value":"las yemas"}]},{"type":"text","value":"."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Poner "},{"type":"element","tag":"recipe-amount","props":{"ingredient":"flour"},"children":[{"type":"text","value":"la harina"}]},{"type":"text","value":" y "},{"type":"element","tag":"recipe-amount","props":{"ingredient":"salt"},"children":[{"type":"text","value":"la sal"}]},{"type":"text","value":" en un bol. Hacer un hueco en el centro y agregar la mezcla líquida y el anís triturado."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Integrar y amasar brevemente hasta obtener una masa lisa y uniforme. Tapar y dejar descansar 30 minutos a temperatura ambiente."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Dividir la masa en 8 porciones iguales y formar bollitos. Mantenerlos tapados mientras se trabaja cada uno para que no se sequen."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Precalentar el horno a 200 °C. Estirar cada bollito muy fino, hasta formar un disco de unos 22 cm. Se puede estirar directamente sobre papel manteca para facilitar el traslado."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Pinchar cada disco por toda la superficie con un tenedor y hornear sobre una placa, de a uno o varios a la vez según el espacio, durante aproximadamente 6–10 minutos, hasta que estén apenas dorados y secos."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Dejar enfriar las capas completamente. Manipularlas con cuidado: son finas y quebradizas."}]}]},{"type":"element","tag":"h3","props":{"id":"armado"},"children":[{"type":"text","value":"Armado"}]},{"type":"element","tag":"ol","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Poner un poco de dulce de leche en el centro del plato para fijar la torta. Colocar la primera capa y untarla con una capa fina de dulce de leche, llegando hasta los bordes."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Seguir alternando capas y dulce de leche hasta apilar las 8 capas. Reservar la última capa para la parte superior, sin cubrirla de dulce."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Presionar muy suavemente para emparejar la torta, sin quebrar las capas."}]}]},{"type":"element","tag":"h3","props":{"id":"merengue-italiano"},"children":[{"type":"text","value":"Merengue italiano"}]},{"type":"element","tag":"ol","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Poner "},{"type":"element","tag":"recipe-amount","props":{"ingredient":"italian-sugar"},"children":[{"type":"text","value":"el azúcar"}]},{"type":"text","value":" y "},{"type":"element","tag":"recipe-amount","props":{"ingredient":"italian-water"},"children":[{"type":"text","value":"el agua"}]},{"type":"text","value":" en una olla pequeña. Calentar sin revolver una vez que empiece a hervir y cocinar hasta que el almíbar alcance 118 °C."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Cuando el almíbar esté cerca de esa temperatura, empezar a batir "},{"type":"element","tag":"recipe-amount","props":{"ingredient":"italian-whites"},"children":[{"type":"text","value":"las claras"}]},{"type":"text","value":" hasta que estén espumosas y formen picos suaves."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Con la batidora en marcha, verter el almíbar caliente en un hilo fino sobre las claras, evitando que caiga sobre el batidor o las paredes del bol."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Seguir batiendo hasta que el merengue esté firme, brillante y se haya enfriado."}]}]},{"type":"element","tag":"h3","props":{"id":"merengue-miel-de-caña"},"children":[{"type":"text","value":"Merengue Miel de caña"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"Esta variante reemplaza parte del azúcar por miel de caña. El merengue queda más oscuro y con un sabor más intenso que el clásico. Prepararlo justo antes de decorar."}]},{"type":"element","tag":"ol","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Poner "},{"type":"element","tag":"recipe-amount","props":{"ingredient":"cane-sugar"},"children":[{"type":"text","value":"el azúcar"}]},{"type":"text","value":", "},{"type":"element","tag":"recipe-amount","props":{"ingredient":"cane-honey"},"children":[{"type":"text","value":"la miel de caña"}]},{"type":"text","value":" y "},{"type":"element","tag":"recipe-amount","props":{"ingredient":"cane-water"},"children":[{"type":"text","value":"el agua"}]},{"type":"text","value":" en una olla pequeña. Calentar, revolviendo solo hasta que el azúcar se disuelva; cuando hierva, dejar de revolver."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Cuando el almíbar se acerque a 110 °C, empezar a batir "},{"type":"element","tag":"recipe-amount","props":{"ingredient":"cane-whites"},"children":[{"type":"text","value":"las claras"}]},{"type":"text","value":" hasta que estén espumosas y formen picos suaves."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Llevar el almíbar a 116–118 °C. Con la batidora en marcha, verterlo en un hilo fino sobre las claras, evitando que caiga sobre el batidor o las paredes del bol."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Seguir batiendo hasta que el merengue esté firme, brillante y se haya enfriado."}]}]},{"type":"element","tag":"h3","props":{"id":"terminación"},"children":[{"type":"text","value":"Terminación"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"Cubrir la parte superior de la torta con el merengue clásico o el de miel de caña. Formar picos con una espátula o una cuchara; si se desea, dorarlos suavemente con un soplete."}]},{"type":"element","tag":"ol","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Dejar reposar un rato antes de cortar para que el relleno se asiente. Usar un cuchillo de sierra para obtener porciones prolijas."}]}]}]}],"toc":{"title":"","searchDepth":2,"depth":2,"links":[{"id":"masa","depth":3,"text":"Masa"},{"id":"armado","depth":3,"text":"Armado"},{"id":"merengue-italiano","depth":3,"text":"Merengue italiano"},{"id":"merengue-miel-de-caña","depth":3,"text":"Merengue Miel de caña"},{"id":"terminación","depth":3,"text":"Terminación"}]}},"_type":"markdown","_id":"content:recetas:rogel.md","_source":"content","_file":"recetas/rogel.md","_stem":"recetas/rogel","_extension":"md"}