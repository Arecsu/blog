e":["emoji-inline"],"width":64,"height":64,"src":"data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2232%22 height=%2232%22 fill=%22none%22 viewBox=%220 0 32 32%22%3E%3Cpath fill=%22%23D3D3D3%22 d=%22M2 22.93v1.22c0 .21.11.42.33.53l10.15 4.99c.62.31 1.36.31 1.98 0l15.2-7.4c.22-.11.33-.32.33-.53v-1.22L2 22.93Z%22/%3E%3Cpath fill=%22%23F4F4F4%22 d=%22M18.26 14.67 2.33 22.43a.59.59 0 0 0 0 1.06l10.15 4.99c.62.31 1.36.31 1.98 0l15.2-7.4a.59.59 0 0 0 0-1.06l-10.88-5.35a.593.593 0 0 0-.52 0Z%22/%3E%3Cpath fill=%22%23FCD53F%22 d=%22M18.91 12.13c-.35-.17-.75-.17-1.09 0l-8.04 3.85c-.26.13-.43.4-.43.69 2.282 3.17 4.581 5.314 7.619 7.88l.101.05c.21.1.46.1.68 0l.129-.062C21.875 20.594 22.5 20 26.42 16.3c0-.29-.17-.56-.43-.69l-7.08-3.48Z%22/%3E%3Cpath fill=%22%23FFF478%22 d=%22M9.35 20.424v-3.77c0-.2.21-.34.4-.25l7.35 3.62c.19.09.31.29.31.5v3.73c0 .24-.25.4-.47.29l-7.23-3.55a.63.63 0 0 1-.36-.57Z%22/%3E%3Cpath fill=%22%23FFF478%22 d=%22M9.35 20.424v-3.77c0-.2.21-.34.4-.25l7.35 3.62c.19.09.31.29.31.5v3.73c0 .24-.25.4-.47.29l-7.23-3.55a.63.63 0 0 1-.36-.57Z%22/%3E%3Cpath fill=%22%23FCD53F%22 d=%22M8.4 17.31c-.35-.17-.75-.17-1.09 0l-.98.47c-.26.13-.43.39-.43.69 2.214 3.167 5.18 4.872 7.62 7.88l.1.05c.21.1.46.1.68 0l.133-.065c.25-1.71.905-3.188 1.477-4.855 0-.29-.17-.56-.43-.69L8.4 17.31Z%22/%3E%3Cpath fill=%22%23FFF478%22 d=%22M5.9 22.223v-3.77c0-.2.21-.34.4-.25l7.36 3.62c.19.09.31.29.31.5v3.73c0 .24-.25.4-.47.29l-7.24-3.56a.615.615 0 0 1-.36-.56Z%22/%3E%3Cpath fill=%22%23F9C23C%22 d=%22M26.43 16.284v3.77c0 .24-.14.46-.35.56l-8.19 3.93a.323.323 0 0 1-.47-.29v-3.73c0-.21.12-.41.31-.5l8.3-3.99c.19-.09.4.05.4.25Zm-10.52 5.189v3.77c0 .24-.13.46-.35.55l-1.13.55a.323.323 0 0 1-.47-.29v-3.73c0-.21.12-.41.31-.5l1.24-.6c.19-.09.4.05.4.25Z%22/%3E%3C/svg%3E","alt":"🧈"},"children":[]},{"type":"text","value":" Manteca"}]},{"type":"element","tag":"li","props":{},"children":[{"type":"element","tag":"code","props":{"className":[]},"children":[{"type":"text","value":"250 g"}]},{"type":"text","value":" Queso crema firme"}]},{"type":"element","tag":"li","props":{},"children":[{"type":"element","tag":"code","props":{"className":[]},"children":[{"type":"text","value":"750 g"}]},{"type":"text","value":" Azúcar impalpable"}]},{"type":"element","tag":"li","props":{},"children":[{"type":"element","tag":"code","props":{"className":[]},"children":[{"type":"text","value":"1 pizca"}]},{"type":"text","value":" Sal"}]}]}]}]},{"type":"element","tag":"recipe-process","props":{":process":"true"},"children":[{"type":"element","tag":"p","props":{},"children":[{"type":"element","tag":"strong","props":{},"children":[{"type":"text","value":"Rinde:"}]},{"type":"text","value":" una torta de varias capas. La receta original usa moldes de aproximadamente 20 cm de diámetro."}]},{"type":"element","tag":"h3","props":{"id":"preparación-de-los-moldes"},"children":[{"type":"text","value":"Preparación de los moldes"}]},{"type":"element","tag":"ol","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Enmantecar los moldes y cubrir la base con papel manteca. Enmantecar también el papel y llevar los moldes al frío mientras se prepara la masa."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Precalentar el horno a 200 °C si se van a hornear capas finas en moldes de 20 cm. Para hornear toda la preparación en un solo molde, usar un horno más bajo (160–180 °C) y controlar la cocción, que llevará más tiempo."}]}]},{"type":"element","tag":"h3","props":{"id":"buttermilk"},"children":[{"type":"text","value":"Buttermilk"}]},{"type":"element","tag":"ol","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Mezclar la leche con el vinagre y dejar reposar unos minutos, hasta que la leche se vea cortada. Reservar."}]}]},{"type":"element","tag":"h3","props":{"id":"bizcochuelo"},"children":[{"type":"text","value":"Bizcochuelo"}]},{"type":"element","tag":"ol","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Batir la manteca pomada con el azúcar y el extracto de vainilla hasta obtener una mezcla cremosa y aireada."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Agregar los huevos de a uno, batiendo solo hasta que se integren."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Incorporar el buttermilk de a poco. Es posible que la mezcla parezca cortada; continuar con la receta."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Agregar el colorante rojo y mezclar hasta distribuirlo de manera pareja."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Tamizar juntos la harina, el cacao y el polvo de hornear. Incorporarlos a la preparación en tandas, mezclando solo hasta integrar."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Repartir la masa entre los moldes preparados. Si no se cuenta con balanza, dividirla lo más parejo posible."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Hornear las capas a 200 °C durante unos 20 minutos, o hasta que al insertar un palillo en el centro salga limpio. Si se usa un solo molde, hornear a 160–180 °C y comprobar la cocción con el palillo."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Dejar enfriar por completo antes de desmoldar y armar."}]}]},{"type":"element","tag":"h3","props":{"id":"almíbar"},"children":[{"type":"text","value":"Almíbar"}]},{"type":"element","tag":"ol","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Poner el agua y el azúcar en una olla pequeña. Calentar hasta que el azúcar se disuelva."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Retirar del fuego y dejar enfriar."}]}]},{"type":"element","tag":"h3","props":{"id":"cream-cheese-buttercream"},"children":[{"type":"text","value":"Cream cheese buttercream"}]},{"type":"element","tag":"ol","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Batir la manteca, el queso crema, el azúcar impalpable y la sal hasta obtener una crema aireada y homogénea, aproximadamente 10 minutos."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Si el queso crema es blando, batir primero la manteca con el azúcar impalpable y la sal; incorporar el queso crema al final y batir solo hasta integrar para evitar que la crema se afloje."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Si queda demasiado blanda, llevarla a la heladera mientras se prepara la torta."}]}]},{"type":"element","tag":"h3","props":{"id":"armado-y-decoración"},"children":[{"type":"text","value":"Armado y decoración"}]},{"type":"element","tag":"ol","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Nivelar las capas frías con un cuchillo serrado. Reservar los recortes para la decoración."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Pincelar cada capa ligeramente con almíbar; al ser un bizcochuelo húmedo, no hace falta empaparlo."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Rellenar entre las capas con buttercream y apilarlas."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Cubrir la torta con una capa fina de buttercream, dejando parte de los bizcochuelos a la vista si se desea el acabado "},{"type":"element","tag":"em","props":{},"children":[{"type":"text","value":"naked cake"}]},{"type":"text","value":". Enfriar para que quede firme antes de continuar."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Desmenuzar los recortes y repartir las migas sobre la torta. Decorar con copos de buttercream si se desea."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Refrigerar la torta decorada y dejarla atemperar un poco antes de servir."}]}]}]}],"toc":{"title":"","searchDepth":2,"depth":2,"links":[{"id":"preparación-de-los-moldes","depth":3,"text":"Preparación de los moldes"},{"id":"buttermilk","depth":3,"text":"Buttermilk"},{"id":"bizcochuelo","depth":3,"text":"Bizcochuelo"},{"id":"almíbar","depth":3,"text":"Almíbar"},{"id":"cream-cheese-buttercream","depth":3,"text":"Cream cheese buttercream"},{"id":"armado-y-decoración","depth":3,"text":"Armado y decoración"}]}},"_type":"markdown","_id":"content:recetas:red-velvet-cake.md","_source":"content","_file":"recetas/red-velvet-cake.md","_stem":"recetas/red-velvet-cake","_extension":"md"}