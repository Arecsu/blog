dient":22},[170],{"type":121,"value":171},"Harina",{"type":121,"value":173},". ",{"type":106,"tag":175,"props":176,"children":182},"img",{"className":177,"width":179,"height":179,"src":180,"alt":181},[178],"emoji-inline",64,"data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2232%22 height=%2232%22 fill=%22none%22 viewBox=%220 0 32 32%22%3E%3Cpath fill=%22%23FFB02E%22 d=%22m14.839 5.668-12.66 21.93c-.51.89.13 2.01 1.16 2.01h25.32c1.03 0 1.67-1.11 1.16-2.01l-12.66-21.93c-.52-.89-1.8-.89-2.32 0Z%22/%3E%3Cpath fill=%22%23000%22 d=%22M14.599 21.497a1.4 1.4 0 1 0 2.8-.01v-9.16c0-.77-.62-1.4-1.4-1.4-.77 0-1.4.62-1.4 1.4v9.17Zm2.8 3.98a1.4 1.4 0 1 1-2.8 0 1.4 1.4 0 0 1 2.8 0Z%22/%3E%3C/svg%3E","⚠️",[],{"type":121,"value":184}," Solamente mezclar hasta integrar la harina. No amasar más que eso, para no desarrollar el glúten. De lo contrario, haría una masa elástica que no es muy atractiva de comer. Queremos algo quebradizo.",{"type":106,"tag":134,"props":186,"children":187},{},[188,192,193,198,199,204],{"type":106,"tag":140,"props":189,"children":190},{"ingredient":31},[191],{"type":121,"value":32},{"type":121,"value":146},{"type":106,"tag":140,"props":194,"children":195},{"ingredient":88},[196],{"type":121,"value":197},"trocitos de chocolate",{"type":121,"value":153},{"type":106,"tag":140,"props":200,"children":201},{"ingredient":99},[202],{"type":121,"value":203},"nueces",{"type":121,"value":205},". De nuevo: hasta integrar, amasando lo menos posible.",{"type":106,"tag":124,"props":207,"children":208},{},[209,215],{"type":106,"tag":210,"props":211,"children":212},"strong",{},[213],{"type":121,"value":214},"Nueces",{"type":121,"value":216},": lo que yo hago para trituar las nueces es ponerlas sobre un plato o tabla de madera, y las cubro con una servilleta de tela, de esas grandes para uso general en la cocina. Y con un martillo de cocina las voy aplastando. Así no salen volando a todos lados.",{"type":106,"tag":116,"props":218,"children":220},{"id":219},"rollos-y-heladera",[221],{"type":121,"value":222},"Rollos y heladera",{"type":106,"tag":124,"props":224,"children":225},{},[226,228,234],{"type":121,"value":227},"El siguiente paso es armar rollos. Puede que la mezcla esté muy blanda como para formar rollos sólidos. Si es así, llevar a la heladera por ",{"type":106,"tag":175,"props":229,"children":233},{"className":230,"width":179,"height":179,"src":231,"alt":232},[178],"data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2232%22 height=%2232%22 fill=%22none%22 viewBox=%220 0 32 32%22%3E%3Cpath fill=%22%233F5FFF%22 d=%22M9 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v4.252A11.945 11.945 0 0 0 16 5c-2.612 0-5.03.835-7 2.252V3Zm7 24c2.612 0 5.03-.835 7-2.252V29a1 1 0 0 1-1 1H10a1 1 0 0 1-1-1v-4.252A11.946 11.946 0 0 0 16 27Zm11-13a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h1.5a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1H27Z%22/%3E%3Cpath fill=%22%23A4AEEB%22 d=%22M28 16c0 6.627-5.373 12-12 12S4 22.627 4 16 9.373 4 16 4s12 5.373 12 12Z%22/%3E%3Cpath fill=%22%235235A6%22 d=%22M25 16a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z%22/%3E%3Cpath fill=%22%23fff%22 d=%22M16 8a1 1 0 0 0-1 1v6c0 .21.065.406.177.568l-3.267 3.641a1 1 0 1 0 1.49 1.336l3.338-3.723a1 1 0 0 0 .075-1.24A.995.995 0 0 0 17 15V9a1 1 0 0 0-1-1Z%22/%3E%3Cpath fill=%22%23FCD53F%22 d=%22M18 16a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z%22/%3E%3C/svg%3E","⌚",[],{"type":121,"value":235}," 30 minutos a 1 hora para que tome más dureza.",{"type":106,"tag":124,"props":237,"children":238},{},[239],{"type":121,"value":240},"Con la masa más sólida, se preparan rollos en forma de cilindros del diámetro un poco mas pequeños que la galleta. Recordar que las galletas crecerán un poco más de tamaño en el horneado.",{"type":106,"tag":124,"props":242,"children":243},{},[244],{"type":121,"value":245},"Colocar los rollos en una bandeja. Cubrir la bandeja con papel manteca, film o de aluminio. Se puede usar un tupper también.",{"type":106,"tag":124,"props":247,"children":248},{},[249],{"type":121,"value":250},"Llevarlos a la heladera donde estarán por aproximadamente 24 horas. Con esto, la harina hará una correcta hidratación y la masa tendrá un sabor más rico e intenso.",{"type":106,"tag":116,"props":252,"children":254},{"id":253},"horneado",[255],{"type":121,"value":256},"Horneado",{"type":106,"tag":124,"props":258,"children":259},{},[260],{"type":121,"value":261},"Retirar de la heladera.",{"type":106,"tag":124,"props":263,"children":264},{},[265],{"type":121,"value":266},"Cortar los cilindros en rodajas y colocarlos sobre una placa enmantecada y enharinada.",{"type":106,"tag":124,"props":268,"children":269},{},[270],{"type":121,"value":271},"Dejar espacio entre las galletas. Cocinar a horno moderado.",{"type":106,"tag":124,"props":273,"children":274},{},[275],{"type":121,"value":276},"El punto justo es cuando la parte de abajo de las galletas se pone un poco oscura, como un bronceado. Es un punto crítico, así que en las primeras tandas requerirá de constante inspección para calcular el tiempo justo. Menos de ese punto sale un poco cruda, y de más ya con un sabor quemado.",{"type":106,"tag":124,"props":278,"children":279},{},[280],{"type":121,"value":281},"La galleta final tiene que tener la crocantez y textura de una típica galleta.",{"title":7,"searchDepth":283,"depth":283,"links":284},2,[],"markdown","content:recetas:galletas-de-avena.md","content","recetas/galletas-de-avena.md","recetas/galletas-de-avena","md",1792103164848]