%3E%3Cpath fill=%22%239B9B9B%22 d=%22M12.988 4.19a.54.54 0 1 0 0-1.08.54.54 0 0 0 0 1.08Zm6.08 0a.54.54 0 1 0 0-1.08.54.54 0 0 0 0 1.08Zm-3.95 1.21a.54.54 0 1 1-1.08 0 .54.54 0 0 1 1.08 0Zm2.89 0a.54.54 0 1 1-1.08 0 .54.54 0 0 1 1.08 0Zm-1.44-1.75a.54.54 0 1 1-1.08 0 .54.54 0 0 1 1.08 0Zm-6.08 3.93h11.04v3.77h-11.04V7.58Z%22/%3E%3C/svg%3E",{"text":65}," Sal",{"id":67,"label":68,"items":69},"relleno","Relleno",[70],{"id":71,"label":72,"quantity":73,"unit":21,"note":74},"dulce-de-leche","Dulce de leche repostero",800,"aprox.",{"id":76,"label":77,"items":78},"merengue-italiano","Merengue italiano",[79,88,92],{"id":80,"label":81,"quantity":82,"whole":11,"labelParts":83},"italian-whites","Claras",3,[84,86],{"emoji":85},{"alt":29,"src":30},{"text":87}," Claras",{"id":89,"label":90,"quantity":91,"unit":21},"italian-sugar","Azúcar",180,{"id":93,"label":46,"quantity":94,"unit":21},"italian-water",50,{"id":96,"label":97,"items":98},"merengue-miel-de-cana","Merengue Miel de caña",[99,105,108,112],{"id":100,"label":81,"quantity":82,"whole":11,"labelParts":101},"cane-whites",[102,104],{"emoji":103},{"alt":29,"src":30},{"text":87},{"id":106,"label":90,"quantity":107,"unit":21},"cane-sugar",120,{"id":109,"label":110,"quantity":111,"unit":21},"cane-honey","Miel de caña",72,{"id":113,"label":46,"quantity":94,"unit":21},"cane-water",{"type":115,"children":116,"toc":375},"root",[117,122],{"type":118,"tag":119,"props":120,"children":121},"element","recipe-ingredients",{},[],{"type":118,"tag":123,"props":124,"children":126},"recipe-process",{":process":125},"true",[127,140,146,233,239,257,261,302,307,312,356,362,367],{"type":118,"tag":128,"props":129,"children":130},"p",{},[131,138],{"type":118,"tag":132,"props":133,"children":134},"strong",{},[135],{"type":136,"value":137},"text","Rinde:",{"type":136,"value":139}," 1 torta de 8 capas de 22 cm de diámetro.",{"type":118,"tag":141,"props":142,"children":143},"h3",{"id":14},[144],{"type":136,"value":145},"Masa",{"type":118,"tag":147,"props":148,"children":149},"ol",{},[150,164,190,208,213,218,223,228],{"type":118,"tag":151,"props":152,"children":153},"li",{},[154,156,162],{"type":136,"value":155},"Tostar ",{"type":118,"tag":157,"props":158,"children":159},"recipe-amount",{"ingredient":50},[160],{"type":136,"value":161},"las semillas de anís",{"type":136,"value":163}," en una sartén seca a fuego bajo, moviéndolas para que no se quemen. Cuando desprendan aroma, retirarlas y triturarlas.",{"type":118,"tag":151,"props":165,"children":166},{},[167,169,174,176,181,183,188],{"type":136,"value":168},"Derretir ",{"type":118,"tag":157,"props":170,"children":171},{"ingredient":34},[172],{"type":136,"value":173},"la manteca",{"type":136,"value":175}," y dejarla entibiar. Mezclarla con ",{"type":118,"tag":157,"props":177,"children":178},{"ingredient":45},[179],{"type":136,"value":180},"el agua",{"type":136,"value":182}," y ",{"type":118,"tag":157,"props":184,"children":185},{"ingredient":23},[186],{"type":136,"value":187},"las yemas",{"type":136,"value":189},".",{"type":118,"tag":151,"props":191,"children":192},{},[193,195,200,201,206],{"type":136,"value":194},"Poner ",{"type":118,"tag":157,"props":196,"children":197},{"ingredient":18},[198],{"type":136,"value":199},"la harina",{"type":136,"value":182},{"type":118,"tag":157,"props":202,"children":203},{"ingredient":55},[204],{"type":136,"value":205},"la sal",{"type":136,"value":207}," en un bol. Hacer un hueco en el centro y agregar la mezcla líquida y el anís triturado.",{"type":118,"tag":151,"props":209,"children":210},{},[211],{"type":136,"value":212},"Integrar y amasar brevemente hasta obtener una masa lisa y uniforme. Tapar y dejar descansar 30 minutos a temperatura ambiente.",{"type":118,"tag":151,"props":214,"children":215},{},[216],{"type":136,"value":217},"Dividir la masa en 8 porciones iguales y formar bollitos. Mantenerlos tapados mientras se trabaja cada uno para que no se sequen.",{"type":118,"tag":151,"props":219,"children":220},{},[221],{"type":136,"value":222},"Precalentar el horno a 200 °C. Estirar cada bollito muy fino, hasta formar un disco de unos 22 cm. Se puede estirar directamente sobre papel manteca para facilitar el traslado.",{"type":118,"tag":151,"props":224,"children":225},{},[226],{"type":136,"value":227},"Pinchar cada disco por toda la superficie con un tenedor y hornear sobre una placa, de a uno o varios a la vez según el espacio, durante aproximadamente 6–10 minutos, hasta que estén apenas dorados y secos.",{"type":118,"tag":151,"props":229,"children":230},{},[231],{"type":136,"value":232},"Dejar enfriar las capas completamente. Manipularlas con cuidado: son finas y quebradizas.",{"type":118,"tag":141,"props":234,"children":236},{"id":235},"armado",[237],{"type":136,"value":238},"Armado",{"type":118,"tag":147,"props":240,"children":241},{},[242,247,252],{"type":118,"tag":151,"props":243,"children":244},{},[245],{"type":136,"value":246},"Poner un poco de dulce de leche en el centro del plato para fijar la torta. Colocar la primera capa y untarla con una capa fina de dulce de leche, llegando hasta los bordes.",{"type":118,"tag":151,"props":248,"children":249},{},[250],{"type":136,"value":251},"Seguir alternando capas y dulce de leche hasta apilar las 8 capas. Reservar la última capa para la parte superior, sin cubrirla de dulce.",{"type":118,"tag":151,"props":253,"children":254},{},[255],{"type":136,"value":256},"Presionar muy suavemente para emparejar la torta, sin quebrar las capas.",{"type":118,"tag":141,"props":258,"children":259},{"id":76},[260],{"type":136,"value":77},{"type":118,"tag":147,"props":262,"children":263},{},[264,280,292,297],{"type":118,"tag":151,"props":265,"children":266},{},[267,268,273,274,278],{"type":136,"value":194},{"type":118,"tag":157,"props":269,"children":270},{"ingredient":89},[271],{"type":136,"value":272},"el azúcar",{"type":136,"value":182},{"type":118,"tag":157,"props":275,"children":276},{"ingredient":93},[277],{"type":136,"value":180},{"type":136,"value":279}," en una olla pequeña. Calentar sin revolver una vez que empiece a hervir y cocinar hasta que el almíbar alcance 118 °C.",{"type":118,"tag":151,"props":281,"children":282},{},[283,285,290],{"type":136,"value":284},"Cuando el almíbar esté cerca de esa temperatura, empezar a batir ",{"type":118,"tag":157,"props":286,"children":287},{"ingredient":80},[288],{"type":136,"value":289},"las claras",{"type":136,"value":291}," hasta que estén espumosas y formen picos suaves.",{"type":118,"tag":151,"props":293,"children":294},{},[295],{"type":136,"value":296},"Con la batidora en marcha, verter el almíbar caliente en un hilo fino sobre las claras, evitando que caiga sobre el batidor o las paredes del bol.",{"type":118,"tag":151,"props":298,"children":299},{},[300],{"type":136,"value":301},"Seguir batiendo hasta que el merengue esté firme, brillante y se haya enfriado.",{"type":118,"tag":141,"props":303,"children":305},{"id":304},"merengue-miel-de-caña",[306],{"type":136,"value":97},{"type":118,"tag":128,"props":308,"children":309},{},[310],{"type":136,"value":311},"Esta variante reemplaza parte del azúcar por miel de caña. El merengue queda más oscuro y con un sabor más intenso que el clásico. Prepararlo justo antes de decorar.",{"type":118,"tag":147,"props":313,"children":314},{},[315,337,347,352],{"type":118,"tag":151,"props":316,"children":317},{},[318,319,323,325,330,331,335],{"type":136,"value":194},{"type":118,"tag":157,"props":320,"children":321},{"ingredient":106},[322],{"type":136,"value":272},{"type":136,"value":324},", ",{"type":118,"tag":157,"props":326,"children":327},{"ingredient":109},[328],{"type":136,"value":329},"la miel de caña",{"type":136,"value":182},{"type":118,"tag":157,"props":332,"children":333},{"ingredient":113},[334],{"type":136,"value":180},{"type":136,"value":336}," en una olla pequeña. Calentar, revolviendo solo hasta que el azúcar se disuelva; cuando hierva, dejar de revolver.",{"type":118,"tag":151,"props":338,"children":339},{},[340,342,346],{"type":136,"value":341},"Cuando el almíbar se acerque a 110 °C, empezar a batir ",{"type":118,"tag":157,"props":343,"children":344},{"ingredient":100},[345],{"type":136,"value":289},{"type":136,"value":291},{"type":118,"tag":151,"props":348,"children":349},{},[350],{"type":136,"value":351},"Llevar el almíbar a 116–118 °C. Con la batidora en marcha, verterlo en un hilo fino sobre las claras, evitando que caiga sobre el batidor o las paredes del bol.",{"type":118,"tag":151,"props":353,"children":354},{},[355],{"type":136,"value":301},{"type":118,"tag":141,"props":357,"children":359},{"id":358},"terminación",[360],{"type":136,"value":361},"Terminación",{"type":118,"tag":128,"props":363,"children":364},{},[365],{"type":136,"value":366},"Cubrir la parte superior de la torta con el merengue clásico o el de miel de caña. Formar picos con una espátula o una cuchara; si se desea, dorarlos suavemente con un soplete.",{"type":118,"tag":147,"props":368,"children":369},{},[370],{"type":118,"tag":151,"props":371,"children":372},{},[373],{"type":136,"value":374},"Dejar reposar un rato antes de cortar para que el relleno se asiente. Usar un cuchillo de sierra para obtener porciones prolijas.",{"title":7,"searchDepth":376,"depth":376,"links":377},2,[378,379,380,381,382],{"id":14,"depth":82,"text":145},{"id":235,"depth":82,"text":238},{"id":76,"depth":82,"text":77},{"id":304,"depth":82,"text":97},{"id":358,"depth":82,"text":361},"markdown","content:recetas:rogel.md","content","recetas/rogel.md","recetas/rogel","md",1792126626676]