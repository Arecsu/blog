erengue italiano",[144],{"type":15,"tag":25,"props":145,"children":146},{},[147,163,174],{"type":15,"tag":29,"props":148,"children":149},{},[150,156,157,161],{"type":15,"tag":33,"props":151,"children":153},{"className":152},[],[154],{"type":38,"value":155},"3",{"type":38,"value":52},{"type":15,"tag":54,"props":158,"children":160},{"className":159,"width":58,"height":58,"src":59,"alt":60},[57],[],{"type":38,"value":162}," Claras",{"type":15,"tag":29,"props":164,"children":165},{},[166,172],{"type":15,"tag":33,"props":167,"children":169},{"className":168},[],[170],{"type":38,"value":171},"180 g",{"type":38,"value":173}," Azúcar",{"type":15,"tag":29,"props":175,"children":176},{},[177,183],{"type":15,"tag":33,"props":178,"children":180},{"className":179},[],[181],{"type":38,"value":182},"50 g",{"type":38,"value":92},{"type":15,"tag":20,"props":185,"children":187},{"name":186},"Merengue Miel de caña",[188],{"type":15,"tag":25,"props":189,"children":190},{},[191,205,215,226],{"type":15,"tag":29,"props":192,"children":193},{},[194,199,200,204],{"type":15,"tag":33,"props":195,"children":197},{"className":196},[],[198],{"type":38,"value":155},{"type":38,"value":52},{"type":15,"tag":54,"props":201,"children":203},{"className":202,"width":58,"height":58,"src":59,"alt":60},[57],[],{"type":38,"value":162},{"type":15,"tag":29,"props":206,"children":207},{},[208,214],{"type":15,"tag":33,"props":209,"children":211},{"className":210},[],[212],{"type":38,"value":213},"120 g",{"type":38,"value":173},{"type":15,"tag":29,"props":216,"children":217},{},[218,224],{"type":15,"tag":33,"props":219,"children":221},{"className":220},[],[222],{"type":38,"value":223},"72 g",{"type":38,"value":225}," Miel de caña",{"type":15,"tag":29,"props":227,"children":228},{},[229,234],{"type":15,"tag":33,"props":230,"children":232},{"className":231},[],[233],{"type":38,"value":182},{"type":38,"value":92},{"type":15,"tag":236,"props":237,"children":239},"recipe-process",{":process":238},"true",[240,252,259,303,309,327,332,355,360,365,387,393,398],{"type":15,"tag":241,"props":242,"children":243},"p",{},[244,250],{"type":15,"tag":245,"props":246,"children":247},"strong",{},[248],{"type":38,"value":249},"Rinde:",{"type":38,"value":251}," 1 torta de 8 capas de 22 cm de diámetro.",{"type":15,"tag":253,"props":254,"children":256},"h3",{"id":255},"masa",[257],{"type":38,"value":258},"Masa",{"type":15,"tag":260,"props":261,"children":262},"ol",{},[263,268,273,278,283,288,293,298],{"type":15,"tag":29,"props":264,"children":265},{},[266],{"type":38,"value":267},"Tostar las semillas de anís en una sartén seca a fuego bajo, moviéndolas para que no se quemen. Cuando desprendan aroma, retirarlas y triturarlas.",{"type":15,"tag":29,"props":269,"children":270},{},[271],{"type":38,"value":272},"Derretir la manteca y dejarla entibiar. Mezclarla con el agua y las yemas.",{"type":15,"tag":29,"props":274,"children":275},{},[276],{"type":38,"value":277},"Poner la harina y la sal en un bol. Hacer un hueco en el centro y agregar la mezcla líquida y el anís triturado.",{"type":15,"tag":29,"props":279,"children":280},{},[281],{"type":38,"value":282},"Integrar y amasar brevemente hasta obtener una masa lisa y uniforme. Tapar y dejar descansar 30 minutos a temperatura ambiente.",{"type":15,"tag":29,"props":284,"children":285},{},[286],{"type":38,"value":287},"Dividir la masa en 8 porciones iguales y formar bollitos. Mantenerlos tapados mientras se trabaja cada uno para que no se sequen.",{"type":15,"tag":29,"props":289,"children":290},{},[291],{"type":38,"value":292},"Precalentar el horno a 200 °C. Estirar cada bollito muy fino, hasta formar un disco de unos 22 cm. Se puede estirar directamente sobre papel manteca para facilitar el traslado.",{"type":15,"tag":29,"props":294,"children":295},{},[296],{"type":38,"value":297},"Pinchar cada disco por toda la superficie con un tenedor y hornear sobre una placa, de a uno o varios a la vez según el espacio, durante aproximadamente 6–10 minutos, hasta que estén apenas dorados y secos.",{"type":15,"tag":29,"props":299,"children":300},{},[301],{"type":38,"value":302},"Dejar enfriar las capas completamente. Manipularlas con cuidado: son finas y quebradizas.",{"type":15,"tag":253,"props":304,"children":306},{"id":305},"armado",[307],{"type":38,"value":308},"Armado",{"type":15,"tag":260,"props":310,"children":311},{},[312,317,322],{"type":15,"tag":29,"props":313,"children":314},{},[315],{"type":38,"value":316},"Poner un poco de dulce de leche en el centro del plato para fijar la torta. Colocar la primera capa y untarla con una capa fina de dulce de leche, llegando hasta los bordes.",{"type":15,"tag":29,"props":318,"children":319},{},[320],{"type":38,"value":321},"Seguir alternando capas y dulce de leche hasta apilar las 8 capas. Reservar la última capa para la parte superior, sin cubrirla de dulce.",{"type":15,"tag":29,"props":323,"children":324},{},[325],{"type":38,"value":326},"Presionar muy suavemente para emparejar la torta, sin quebrar las capas.",{"type":15,"tag":253,"props":328,"children":330},{"id":329},"merengue-italiano",[331],{"type":38,"value":142},{"type":15,"tag":260,"props":333,"children":334},{},[335,340,345,350],{"type":15,"tag":29,"props":336,"children":337},{},[338],{"type":38,"value":339},"Poner el azúcar y el agua en una olla pequeña. Calentar sin revolver una vez que empiece a hervir y cocinar hasta que el almíbar alcance 118 °C.",{"type":15,"tag":29,"props":341,"children":342},{},[343],{"type":38,"value":344},"Cuando el almíbar esté cerca de esa temperatura, empezar a batir las claras hasta que estén espumosas y formen picos suaves.",{"type":15,"tag":29,"props":346,"children":347},{},[348],{"type":38,"value":349},"Con la batidora en marcha, verter el almíbar caliente en un hilo fino sobre las claras, evitando que caiga sobre el batidor o las paredes del bol.",{"type":15,"tag":29,"props":351,"children":352},{},[353],{"type":38,"value":354},"Seguir batiendo hasta que el merengue esté firme, brillante y se haya enfriado.",{"type":15,"tag":253,"props":356,"children":358},{"id":357},"merengue-miel-de-caña",[359],{"type":38,"value":186},{"type":15,"tag":241,"props":361,"children":362},{},[363],{"type":38,"value":364},"Esta variante reemplaza parte del azúcar por miel de caña. El merengue queda más oscuro y con un sabor más intenso que el clásico. Prepararlo justo antes de decorar.",{"type":15,"tag":260,"props":366,"children":367},{},[368,373,378,383],{"type":15,"tag":29,"props":369,"children":370},{},[371],{"type":38,"value":372},"Poner el azúcar, la miel de caña y el agua en una olla pequeña. Calentar, revolviendo solo hasta que el azúcar se disuelva; cuando hierva, dejar de revolver.",{"type":15,"tag":29,"props":374,"children":375},{},[376],{"type":38,"value":377},"Cuando el almíbar se acerque a 110 °C, empezar a batir las claras hasta que estén espumosas y formen picos suaves.",{"type":15,"tag":29,"props":379,"children":380},{},[381],{"type":38,"value":382},"Llevar el almíbar a 116–118 °C. Con la batidora en marcha, verterlo en un hilo fino sobre las claras, evitando que caiga sobre el batidor o las paredes del bol.",{"type":15,"tag":29,"props":384,"children":385},{},[386],{"type":38,"value":354},{"type":15,"tag":253,"props":388,"children":390},{"id":389},"terminación",[391],{"type":38,"value":392},"Terminación",{"type":15,"tag":241,"props":394,"children":395},{},[396],{"type":38,"value":397},"Cubrir la parte superior de la torta con el merengue clásico o el de miel de caña. Formar picos con una espátula o una cuchara; si se desea, dorarlos suavemente con un soplete.",{"type":15,"tag":260,"props":399,"children":400},{},[401],{"type":15,"tag":29,"props":402,"children":403},{},[404],{"type":38,"value":405},"Dejar reposar un rato antes de cortar para que el relleno se asiente. Usar un cuchillo de sierra para obtener porciones prolijas.",{"title":7,"searchDepth":407,"depth":407,"links":408},2,[409,411,412,413,414],{"id":255,"depth":410,"text":258},3,{"id":305,"dept