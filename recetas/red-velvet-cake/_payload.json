"quantity":111,"unit":21,"labelParts":112},"frosting-butter","Manteca",250,[113,115],{"emoji":114},{"alt":25,"src":26},{"text":116}," Manteca",{"id":118,"label":119,"quantity":111,"unit":21},"cream-cheese","Queso crema firme",{"id":121,"label":122,"quantity":123,"unit":21},"icing-sugar","Azúcar impalpable",750,{"id":125,"label":126,"quantity":127,"unit":128},"salt","Sal",1,"pizca",{"type":130,"children":131,"toc":429},"root",[132,137],{"type":133,"tag":134,"props":135,"children":136},"element","recipe-ingredients",{},[],{"type":133,"tag":138,"props":139,"children":141},"recipe-process",{":process":140},"true",[142,155,162,177,183,206,210,306,311,336,340,382,388],{"type":133,"tag":143,"props":144,"children":145},"p",{},[146,153],{"type":133,"tag":147,"props":148,"children":149},"strong",{},[150],{"type":151,"value":152},"text","Rinde:",{"type":151,"value":154}," una torta de varias capas. La receta original usa moldes de aproximadamente 20 cm de diámetro.",{"type":133,"tag":156,"props":157,"children":159},"h3",{"id":158},"preparación-de-los-moldes",[160],{"type":151,"value":161},"Preparación de los moldes",{"type":133,"tag":163,"props":164,"children":165},"ol",{},[166,172],{"type":133,"tag":167,"props":168,"children":169},"li",{},[170],{"type":151,"value":171},"Enmantecar los moldes y cubrir la base con papel manteca. Enmantecar también el papel y llevar los moldes al frío mientras se prepara la masa.",{"type":133,"tag":167,"props":173,"children":174},{},[175],{"type":151,"value":176},"Precalentar el horno a 200 °C si se van a hornear capas finas en moldes de 20 cm. Para hornear toda la preparación en un solo molde, usar un horno más bajo (160–180 °C) y controlar la cocción, que llevará más tiempo.",{"type":133,"tag":156,"props":178,"children":180},{"id":179},"buttermilk",[181],{"type":151,"value":182},"Buttermilk",{"type":133,"tag":163,"props":184,"children":185},{},[186],{"type":133,"tag":167,"props":187,"children":188},{},[189,191,197,199,204],{"type":151,"value":190},"Mezclar ",{"type":133,"tag":192,"props":193,"children":194},"recipe-amount",{"ingredient":50},[195],{"type":151,"value":196},"la leche",{"type":151,"value":198}," con ",{"type":133,"tag":192,"props":200,"children":201},{"ingredient":61},[202],{"type":151,"value":203},"el vinagre",{"type":151,"value":205}," y dejar reposar unos minutos, hasta que la leche se vea cortada. Reservar.",{"type":133,"tag":156,"props":207,"children":208},{"id":14},[209],{"type":151,"value":15},{"type":133,"tag":163,"props":211,"children":212},{},[213,238,250,255,266,291,296,301],{"type":133,"tag":167,"props":214,"children":215},{},[216,218,223,224,229,231,236],{"type":151,"value":217},"Batir ",{"type":133,"tag":192,"props":219,"children":220},{"ingredient":18},[221],{"type":151,"value":222},"la manteca pomada",{"type":151,"value":198},{"type":133,"tag":192,"props":225,"children":226},{"ingredient":30},[227],{"type":151,"value":228},"el azúcar",{"type":151,"value":230}," y ",{"type":133,"tag":192,"props":232,"children":233},{"ingredient":34},[234],{"type":151,"value":235},"el extracto de vainilla",{"type":151,"value":237}," hasta obtener una mezcla cremosa y aireada.",{"type":133,"tag":167,"props":239,"children":240},{},[241,243,248],{"type":151,"value":242},"Agregar ",{"type":133,"tag":192,"props":244,"children":245},{"ingredient":39},[246],{"type":151,"value":247},"los huevos",{"type":151,"value":249}," de a uno, batiendo solo hasta que se integren.",{"type":133,"tag":167,"props":251,"children":252},{},[253],{"type":151,"value":254},"Incorporar el buttermilk de a poco. Es posible que la mezcla parezca cortada; continuar con la receta.",{"type":133,"tag":167,"props":256,"children":257},{},[258,259,264],{"type":151,"value":242},{"type":133,"tag":192,"props":260,"children":261},{"ingredient":65},[262],{"type":151,"value":263},"el colorante rojo",{"type":151,"value":265}," y mezclar hasta distribuirlo de manera pareja.",{"type":133,"tag":167,"props":267,"children":268},{},[269,271,276,278,283,284,289],{"type":151,"value":270},"Tamizar juntos ",{"type":133,"tag":192,"props":272,"children":273},{"ingredient":69},[274],{"type":151,"value":275},"la harina",{"type":151,"value":277},", ",{"type":133,"tag":192,"props":279,"children":280},{"ingredient":80},[281],{"type":151,"value":282},"el cacao",{"type":151,"value":230},{"type":133,"tag":192,"props":285,"children":286},{"ingredient":91},[287],{"type":151,"value":288},"el polvo de hornear",{"type":151,"value":290},". Incorporarlos a la preparación en tandas, mezclando solo hasta integrar.",{"type":133,"tag":167,"props":292,"children":293},{},[294],{"type":151,"value":295},"Repartir la masa entre los moldes preparados. Si no se cuenta con balanza, dividirla lo más parejo posible.",{"type":133,"tag":167,"props":297,"children":298},{},[299],{"type":151,"value":300},"Hornear las capas a 200 °C durante unos 20 minutos, o hasta que al insertar un palillo en el centro salga limpio. Si se usa un solo molde, hornear a 160–180 °C y comprobar la cocción con el palillo.",{"type":133,"tag":167,"props":302,"children":303},{},[304],{"type":151,"value":305},"Dejar enfriar por completo antes de desmoldar y armar.",{"type":133,"tag":156,"props":307,"children":309},{"id":308},"almíbar",[310],{"type":151,"value":96},{"type":133,"tag":163,"props":312,"children":313},{},[314,331],{"type":133,"tag":167,"props":315,"children":316},{},[317,319,324,325,329],{"type":151,"value":318},"Poner ",{"type":133,"tag":192,"props":320,"children":321},{"ingredient":102},[322],{"type":151,"value":323},"el agua",{"type":151,"value":230},{"type":133,"tag":192,"props":326,"children":327},{"ingredient":99},[328],{"type":151,"value":228},{"type":151,"value":330}," en una olla pequeña. Calentar hasta que el azúcar se disuelva.",{"type":133,"tag":167,"props":332,"children":333},{},[334],{"type":151,"value":335},"Retirar del fuego y dejar enfriar.",{"type":133,"tag":156,"props":337,"children":338},{"id":105},[339],{"type":151,"value":106},{"type":133,"tag":163,"props":341,"children":342},{},[343,372,377],{"type":133,"tag":167,"props":344,"children":345},{},[346,347,352,353,358,359,364,365,370],{"type":151,"value":217},{"type":133,"tag":192,"props":348,"children":349},{"ingredient":109},[350],{"type":151,"value":351},"la manteca",{"type":151,"value":277},{"type":133,"tag":192,"props":354,"children":355},{"ingredient":118},[356],{"type":151,"value":357},"el queso crema",{"type":151,"value":277},{"type":133,"tag":192,"props":360,"children":361},{"ingredient":121},[362],{"type":151,"value":363},"el azúcar impalpable",{"type":151,"value":230},{"type":133,"tag":192,"props":366,"children":367},{"ingredient":125},[368],{"type":151,"value":369},"la sal",{"type":151,"value":371}," hasta obtener una crema aireada y homogénea, aproximadamente 10 minutos.",{"type":133,"tag":167,"props":373,"children":374},{},[375],{"type":151,"value":376},"Si el queso crema es blando, batir primero la manteca con el azúcar impalpable y la sal; incorporar el queso crema al final y batir solo hasta integrar para evitar que la crema se afloje.",{"type":133,"tag":167,"props":378,"children":379},{},[380],{"type":151,"value":381},"Si queda demasiado blanda, llevarla a la heladera mientras se prepara la torta.",{"type":133,"tag":156,"props":383,"children":385},{"id":384},"armado-y-decoración",[386],{"type":151,"value":387},"Armado y decoración",{"type":133,"tag":163,"props":389,"children":390},{},[391,396,401,406,419,424],{"type":133,"tag":167,"props":392,"children":393},{},[394],{"type":151,"value":395},"Nivelar las capas frías con un cuchillo serrado. Reservar los recortes para la decoración.",{"type":133,"tag":167,"props":397,"children":398},{},[399],{"type":151,"value":400},"Pincelar cada capa ligeramente con almíbar; al ser un bizcochuelo húmedo, no hace falta empaparlo.",{"type":133,"tag":167,"props":402,"children":403},{},[404],{"type":151,"value":405},"Rellenar entre las capas con buttercream y apilarlas.",{"type":133,"tag":167,"props":407,"children":408},{},[409,411,417],{"type":151,"value":410},"Cubrir la torta con una capa fina de buttercream, dejando parte de los bizcochuelos a la vista si se desea el acabado ",{"type":133,"tag":412,"props":413,"children":414},"em",{},[415],{"type":151,"value":416},"naked cake",{"type":151,"value":418},". Enfriar para que quede firme antes de continuar.",{"type":133,"tag":167,"props":420,"children":421},{},[422],{"type":151,"value":423},"Desmenuzar los recortes y repartir las migas sobre la torta. Decorar con copos de buttercream si se desea.",{"type":133,"tag":167,"props":425,"children":426},{},[427],{"type":151,"value":428},"Refrigerar la torta decorada y dejarla atemperar un poco antes de servir.",{"title":7,"searchDepth":36,"depth":36,"links":430},[431,433,434,435,436,437],{"id":158,"depth":432,"text":161},3,{"id":179,"depth":432,"text":182},{"id":14,"depth":432,"text":15},{"id":308,"depth":432,"text":96},{"id":105,"depth":432,"text":106},{"id":384,"depth":432,"text":387},"markdown","content:recetas:red-velvet-cake.md","content","recetas/red-velvet-cake.md","recetas/red-velvet-cake","md",{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"icon":9,"alt":10,"inlineAmounts":11,"ingredientGroups":445,"body":492,"_type":438,"_id":439,"_source":440,"_file":441,"_stem":442,"_extension":443},[446,478,482],{"id":14,"label":15,"items":447},[448,453,454,455,460,465,466,467,472,477],{"id":18,"label":19,"quantity":20,"unit":21,"labelParts":449},[450,452],{"emoji":451},{"alt":25,"src":26},{"text":28},{"id":30,"label":31,"quantity":32,"unit":21},{"id":34,"label":35,"quantity":36,"unit":37},{"id":39,"label":40,"quantity":41,"whole":11,"labelParts":456},[457,459],{"emoji":458},{"alt":45,"src":46},{"text":48},{"id":50,"label":51,"quantity":52,"unit":21,"labelParts":461},[462,464],{"emoji":463},{"alt":56,"src":57},{"text":59},{"id":61,"label":62,"quantity":63,"unit":21},{"id":65,"label":66,"quantity":36,"unit":37,"note":67},{"id":69,"label":70,"qua