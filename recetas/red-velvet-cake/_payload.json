ue":205}," Agua",{"type":15,"tag":20,"props":207,"children":209},{"name":208},"Cream cheese buttercream",[210],{"type":15,"tag":25,"props":211,"children":212},{},[213,229,239,250],{"type":15,"tag":29,"props":214,"children":215},{},[216,222,223,227],{"type":15,"tag":33,"props":217,"children":219},{"className":218},[],[220],{"type":38,"value":221},"250 g",{"type":38,"value":41},{"type":15,"tag":43,"props":224,"children":226},{"className":225,"width":47,"height":47,"src":48,"alt":49},[46],[],{"type":38,"value":228}," Manteca",{"type":15,"tag":29,"props":230,"children":231},{},[232,237],{"type":15,"tag":33,"props":233,"children":235},{"className":234},[],[236],{"type":38,"value":221},{"type":38,"value":238}," Queso crema firme",{"type":15,"tag":29,"props":240,"children":241},{},[242,248],{"type":15,"tag":33,"props":243,"children":245},{"className":244},[],[246],{"type":38,"value":247},"750 g",{"type":38,"value":249}," Azúcar impalpable",{"type":15,"tag":29,"props":251,"children":252},{},[253,259],{"type":15,"tag":33,"props":254,"children":256},{"className":255},[],[257],{"type":38,"value":258},"1 pizca",{"type":38,"value":260}," Sal",{"type":15,"tag":262,"props":263,"children":265},"recipe-process",{":process":264},"true",[266,278,285,299,305,313,318,361,366,379,384,402,408],{"type":15,"tag":267,"props":268,"children":269},"p",{},[270,276],{"type":15,"tag":271,"props":272,"children":273},"strong",{},[274],{"type":38,"value":275},"Rinde:",{"type":38,"value":277}," una torta de varias capas. La receta original usa moldes de aproximadamente 20 cm de diámetro.",{"type":15,"tag":279,"props":280,"children":282},"h3",{"id":281},"preparación-de-los-moldes",[283],{"type":38,"value":284},"Preparación de los moldes",{"type":15,"tag":286,"props":287,"children":288},"ol",{},[289,294],{"type":15,"tag":29,"props":290,"children":291},{},[292],{"type":38,"value":293},"Enmantecar los moldes y cubrir la base con papel manteca. Enmantecar también el papel y llevar los moldes al frío mientras se prepara la masa.",{"type":15,"tag":29,"props":295,"children":296},{},[297],{"type":38,"value":298},"Precalentar el horno a 200 °C si se van a hornear capas finas en moldes de 20 cm. Para hornear toda la preparación en un solo molde, usar un horno más bajo (160–180 °C) y controlar la cocción, que llevará más tiempo.",{"type":15,"tag":279,"props":300,"children":302},{"id":301},"buttermilk",[303],{"type":38,"value":304},"Buttermilk",{"type":15,"tag":286,"props":306,"children":307},{},[308],{"type":15,"tag":29,"props":309,"children":310},{},[311],{"type":38,"value":312},"Mezclar la leche con el vinagre y dejar reposar unos minutos, hasta que la leche se vea cortada. Reservar.",{"type":15,"tag":279,"props":314,"children":316},{"id":315},"bizcochuelo",[317],{"type":38,"value":22},{"type":15,"tag":286,"props":319,"children":320},{},[321,326,331,336,341,346,351,356],{"type":15,"tag":29,"props":322,"children":323},{},[324],{"type":38,"value":325},"Batir la manteca pomada con el azúcar y el extracto de vainilla hasta obtener una mezcla cremosa y aireada.",{"type":15,"tag":29,"props":327,"children":328},{},[329],{"type":38,"value":330},"Agregar los huevos de a uno, batiendo solo hasta que se integren.",{"type":15,"tag":29,"props":332,"children":333},{},[334],{"type":38,"value":335},"Incorporar el buttermilk de a poco. Es posible que la mezcla parezca cortada; continuar con la receta.",{"type":15,"tag":29,"props":337,"children":338},{},[339],{"type":38,"value":340},"Agregar el colorante rojo y mezclar hasta distribuirlo de manera pareja.",{"type":15,"tag":29,"props":342,"children":343},{},[344],{"type":38,"value":345},"Tamizar juntos la harina, el cacao y el polvo de hornear. Incorporarlos a la preparación en tandas, mezclando solo hasta integrar.",{"type":15,"tag":29,"props":347,"children":348},{},[349],{"type":38,"value":350},"Repartir la masa entre los moldes preparados. Si no se cuenta con balanza, dividirla lo más parejo posible.",{"type":15,"tag":29,"props":352,"children":353},{},[354],{"type":38,"value":355},"Hornear las capas a 200 °C durante unos 20 minutos, o hasta que al insertar un palillo en el centro salga limpio. Si se usa un solo molde, hornear a 160–180 °C y comprobar la cocción con el palillo.",{"type":15,"tag":29,"props":357,"children":358},{},[359],{"type":38,"value":360},"Dejar enfriar por completo antes de desmoldar y armar.",{"type":15,"tag":279,"props":362,"children":364},{"id":363},"almíbar",[365],{"type":38,"value":181},{"type":15,"tag":286,"props":367,"children":368},{},[369,374],{"type":15,"tag":29,"props":370,"children":371},{},[372],{"type":38,"value":373},"Poner el agua y el azúcar en una olla pequeña. Calentar hasta que el azúcar se disuelva.",{"type":15,"tag":29,"props":375,"children":376},{},[377],{"type":38,"value":378},"Retirar del fuego y dejar enfriar.",{"type":15,"tag":279,"props":380,"children":382},{"id":381},"cream-cheese-buttercream",[383],{"type":38,"value":208},{"type":15,"tag":286,"props":385,"children":386},{},[387,392,397],{"type":15,"tag":29,"props":388,"children":389},{},[390],{"type":38,"value":391},"Batir la manteca, el queso crema, el azúcar impalpable y la sal hasta obtener una crema aireada y homogénea, aproximadamente 10 minutos.",{"type":15,"tag":29,"props":393,"children":394},{},[395],{"type":38,"value":396},"Si el queso crema es blando, batir primero la manteca con el azúcar impalpable y la sal; incorporar el queso crema al final y batir solo hasta integrar para evitar que la crema se afloje.",{"type":15,"tag":29,"props":398,"children":399},{},[400],{"type":38,"value":401},"Si queda demasiado blanda, llevarla a la heladera mientras se prepara la torta.",{"type":15,"tag":279,"props":403,"children":405},{"id":404},"armado-y-decoración",[406],{"type":38,"value":407},"Armado y decoración",{"type":15,"tag":286,"props":409,"children":410},{},[411,416,421,426,439,444],{"type":15,"tag":29,"props":412,"children":413},{},[414],{"type":38,"value":415},"Nivelar las capas frías con un cuchillo serrado. Reservar los recortes para la decoración.",{"type":15,"tag":29,"props":417,"children":418},{},[419],{"type":38,"value":420},"Pincelar cada capa ligeramente con almíbar; al ser un bizcochuelo húmedo, no hace falta empaparlo.",{"type":15,"tag":29,"props":422,"children":423},{},[424],{"type":38,"value":425},"Rellenar entre las capas con buttercream y apilarlas.",{"type":15,"tag":29,"props":427,"children":428},{},[429,431,437],{"type":38,"value":430},"Cubrir la torta con una capa fina de buttercream, dejando parte de los bizcochuelos a la vista si se desea el acabado ",{"type":15,"tag":432,"props":433,"children":434},"em",{},[435],{"type":38,"value":436},"naked cake",{"type":38,"value":438},". Enfriar para que quede firme antes de continuar.",{"type":15,"tag":29,"props":440,"children":441},{},[442],{"type":38,"value":443},"Desmenuzar los recortes y repartir las migas sobre la torta. Decorar con copos de buttercream si se desea.",{"type":15,"tag":29,"props":445,"children":446},{},[447],{"type":38,"value":448},"Refrigerar la torta decorada y dejarla atemperar un poco antes de servir.",{"title":7,"searchDepth":450,"depth":450,"links":451},2,[452,454,455,456,457,458],{"id":281,"depth":453,"text":284},3,{"id":301,"depth":453,"text":304},{"id":315,"depth":453,"text":22},{"id":363,"depth":453,"text":181},{"id":381,"depth":453,"text":208},{"id":404,"depth":453,"text":407},"markdown","content:recetas:red-velvet-cake.md","content","recetas/red-velvet-cake.md","recetas/red-velvet-cake","md",{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"icon":9,"alt":10,"body":466,"_type":459,"_id":460,"_source":461,"_file":462,"_stem":463,"_extension":464},{"type":12,"children":467,"toc":809},[468,663],{"type":15,"tag":16,"props":469,"children":470},{},[471,592,616],{"type":15,"tag":20,"props":472,"children":473},{"name":22},[474],{"type":15,"tag":25,"props":475,"children":476},{},[477,491,500,509,523,537,546,555,569,583],{"type":15,"tag":29,"pr