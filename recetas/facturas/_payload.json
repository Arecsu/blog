.479 1.645 5.219l-3.25 2.999a2.225 2.225 0 0 0-.683 2.04l.793 4.398c.441 2.45-2.108 4.36-4.345 3.24l-4.536-2.25a2.282 2.282 0 0 0-2.006 0l-4.536 2.25c-2.238 1.11-4.786-.79-4.345-3.24l.793-4.399c.14-.75-.12-1.52-.682-2.04l-3.251-2.998c-1.877-1.73-.893-4.87 1.645-5.22l4.746-.65a2.23 2.23 0 0 0 1.686-1.189l2.248-4.309c1.144-2.17 4.264-2.17 5.398 0Z%22/%3E%3C/svg%3E","⭐",[],{"type":281,"value":282},"text"," Ver el ",{"type":258,"tag":284,"props":285,"children":289},"a",{"href":286,"rel":287},"https://www.youtube.com/watch?v=3BPFp2uPmRk&feature=emb_title",[288],"nofollow",[290],{"type":281,"value":291},"video",{"type":281,"value":293}," al menos una primera vez es ",{"type":258,"tag":295,"props":296,"children":297},"strong",{},[298],{"type":281,"value":299},"NECESARIO",{"type":281,"value":301},".",{"type":258,"tag":268,"props":303,"children":304},{},[305],{"type":281,"value":306},"Los pasos aquí son una referencia básica si ya tenés la experiencia. Hay etapas, como el armado del amasijo y el empaste, que es mucho mejor seguirlos con el video.",{"type":258,"tag":268,"props":308,"children":309},{},[310],{"type":281,"value":311},"Muchos detalles, secretos y cosas importantes allí. Muy buen material.",{"type":258,"tag":313,"props":314,"children":315},"h3",{"id":138},[316],{"type":281,"value":139},{"type":258,"tag":268,"props":318,"children":319},{},[320],{"type":281,"value":321},"Vamos con el empaste primero, ya que deberá descansar un rato en el freezer/heladera al mismo tiempo que hacemos el amasijo.",{"type":258,"tag":268,"props":323,"children":324},{},[325,327,333],{"type":281,"value":326},"Con ",{"type":258,"tag":328,"props":329,"children":330},"recipe-amount",{"ingredient":142},[331],{"type":281,"value":332},"la manteca pomada",{"type":281,"value":334},":",{"type":258,"tag":336,"props":337,"children":338},"ol",{},[339,345,350],{"type":258,"tag":340,"props":341,"children":342},"li",{},[343],{"type":281,"value":344},"Colocarla sobre papel film o papeles plásticos. Que la envuelva de atrás y de adelante.",{"type":258,"tag":340,"props":346,"children":347},{},[348],{"type":281,"value":349},"Aplastarla con las manos y luego con el palo de amasar para darle forma rectangular",{"type":258,"tag":340,"props":351,"children":352},{},[353],{"type":281,"value":354},"Llevar este empaste a la heladera por un tiempo.",{"type":258,"tag":268,"props":356,"children":357},{},[358,364],{"type":258,"tag":272,"props":359,"children":363},{"className":360,"width":276,"height":276,"src":361,"alt":362},[275],"data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2232%22 height=%2232%22 fill=%22none%22 viewBox=%220 0 32 32%22%3E%3Cpath fill=%22%2300A6ED%22 d=%22M15.375 2.015C8.382 2.345 3 8.365 3 15.367V26.88C3 28.6 4.4 30 6.121 30H25.88c1.719 0 3.12-1.4 3.12-3.12V14.996c.01-7.381-6.162-13.332-13.625-12.982Z%22/%3E%3Cpath fill=%22%23636363%22 d=%22M16 25.995c6.075 0 11-4.925 11-11s-4.925-11-11-11-11 4.924-11 11c0 6.075 4.925 11 11 11Z%22/%3E%3Cpath fill=%22%23D3D3D3%22 d=%22M25 14.995a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-13.004-4.62a1 1 0 1 0-1.892-.648 1 1 0 0 0 1.892.647Zm9.954-.32a1 1 0 1 0-2 0 1 1 0 0 0 2 0ZM17 21.995a1 1 0 1 0-2 0 1 1 0 0 0 2 0Zm-5.95-1.05a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm12.842-6.392a1 1 0 1 0-1.796.88 1 1 0 0 0 1.796-.88ZM9.435 15.892a1 1 0 1 0-.88-1.795 1 1 0 0 0 .88 1.795Zm11.828 3.11a1 1 0 1 0-.647 1.892 1 1 0 0 0 .647-1.892Z%22/%3E%3Cpath fill=%22%239B9B9B%22 d=%22M16 18.995c-.55 0-1-.45-1-1v-6c0-.55.45-1 1-1s1 .45 1 1v6c0 .56-.45 1-1 1Z%22/%3E%3Cpath fill=%22%23F8312F%22 d=%22M16 8.995a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z%22/%3E%3C/svg%3E","⏲️",[],{"type":281,"value":365}," De qué depende el tiempo? De que se endurezca el empaste lo suficiente.",{"type":258,"tag":268,"props":367,"children":368},{},[369],{"type":281,"value":370},"El empaste tiene que estar un poquito duro. Si está muy blando, puede resultar en un desastre y explotar al momento de estirarlo junto a la masa.",{"type":258,"tag":268,"props":372,"children":373},{},[374],{"type":281,"value":375},"Recomiendo dejarlo en el freezer para que esté justo cuando terminamos el amasijo.",{"type":258,"tag":377,"props":378,"children":379},"h4",{"id":47},[380],{"type":281,"value":48},{"type":258,"tag":268,"props":382,"children":383},{},[384],{"type":281,"value":385},"Primero se mezclarán los líquidos, y luegos los secos. Esto hará que todos los sabores e ingredientes se integren mucho mejor en la masa final.",{"type":258,"tag":268,"props":387,"children":388},{},[389],{"type":281,"value":390},"Con levadura fresca se refiere a una levadura que se desgrane, que no esté apelmazada. Probablemente una recién comprada del súper y de buena marca. Se puede hacer con levadura seca (se usa la mitad del peso), pero tendrá mejor sabor con una fresca.",{"type":258,"tag":268,"props":392,"children":393},{},[394,396,403,405,411],{"type":281,"value":395},"Luego, para conservar el restante de la levadura, se puede congerlar. Pero al descongelar ya habrá perdido un poco su poder. En vez de ",{"type":258,"tag":397,"props":398,"children":400},"code",{"className":399},[],[401],{"type":281,"value":402},"10g",{"type":281,"value":404}," de levadura, en este caso, se usarían ",{"type":258,"tag":397,"props":406,"children":408},{"className":407},[],[409],{"type":281,"value":410},"15g",{"type":281,"value":412}," para compensar eso.",{"type":258,"tag":336,"props":414,"children":415},{},[416,421,426,431],{"type":258,"tag":340,"props":417,"children":418},{},[419],{"type":281,"value":420},"En un bowl, agregar todo menos la harina.",{"type":258,"tag":340,"props":422,"children":423},{},[424],{"type":281,"value":425},"Mezclar e integrar bien todos estos ingredientes.",{"type":258,"tag":340,"props":427,"children":428},{},[429],{"type":281,"value":430},"Luego, agregar la harina.",{"type":258,"tag":340,"props":432,"children":433},{},[434],{"type":281,"value":435},"Mezclar e integrar todo de a poco",{"type":258,"tag":268,"props":437,"children":438},{},[439],{"type":281,"value":440},"La masa no necesita un buen amasado. De hecho, sería muy malo porque la masa tomaría mucha fuerza y complicaría los pasos siguientes.",{"type":258,"tag":268,"props":442,"children":443},{},[444],{"type":281,"value":445},"¿Qué quiere decir que tiene mucha fuerza? La harina de trigo tiene glúten, y cuando uno la trabaja en un medio de hidratación, se activan sus cadenas de proteínas. Si la masa está recién hecha o se la sigue amasando, va a crear resistencia. A esta resistencia es la referencia a la \"mucha fuerza\". Si la masa descansa un tiempo, estas cadenas le proporcionan elasticidad a la masa (se dice que está relajada) y se hace mucho mas fácil de trabajar.",{"type":258,"tag":336,"props":447,"children":449},{"start":448},5,[450,455],{"type":258,"tag":340,"props":451,"children":452},{},[453],{"type":281,"value":454},"Tapar la masa y dejarla en descanso por unos 15 minutos",{"type":258,"tag":340,"props":456,"children":457},{},[458],{"type":281,"value":459},"Estirar la masa de manera rectangular",{"type":258,"tag":377,"props":461,"children":463},{"id":462},"colocar-el-empaste-en-el-amasijo",[464],{"type":281,"value":465},"Colocar el empaste en el amasijo",{"type":258,"tag":268,"props":467,"children":468},{},[469,471,477],{"type":281,"value":470},"En este apartado y el siguiente realmente es muy conveniente ver el video para saber cómo integrar el empaste con el amasijo y hacer las láminas de hojaldre. A partir del minuto ",{"type":258,"tag":397,"props":472,"children":474},{"className":473},[],[475],{"type":281,"value":476},"15:00",{"type":281,"value":478}," del video de referencia.",{"type":258,"tag":268,"props":480,"children":481},{},[482],{"type":281,"value":483},"Aquí van unas notas importantes como referencias:",{"type":258,"tag":268,"props":485,"children":486},{},[487],{"type":281,"value":488},"Una vez colocado el empaste en el amasijo, necesita un descanso de entre 1hs y 2hs en la heladera antes de ser trabajado y estirado. De lo contrario, podría romperse todo.",{"type":258,"tag":377,"props":490,"children":492},{"id":491},"hojaldrado",[493],{"type":281,"value":494},"Hojaldrado",{"type":258,"tag":268,"props":496,"children":497},{},[498,500,505],{"type":281,"value":499},"Todos los descansos de la masa a partir de aquí tienen ser de entre 1hs y 2hs en la ",{"type":258,"tag":295,"props":501,"children":502},{},[503],{"type":281,"value":504},"heladera",{"type":281,"value":301},{"type":258,"tag":268,"props":507,"children":508},{},[509],{"type":281,"value":510},"Si la manteca consigue romper el amasijo, no hay que asustarse. Si eso sucedió es porque:",{"type":258,"tag":512,"props":513,"children":514},"ul",{},[515,520],{"type":258,"tag":340,"props":516,"children":517},{},[518],{"type":281,"value":519},"Faltó frío",{"type":258,"tag":340,"props":521,"children":522},{},[523],{"type":281,"value":524},"Hubo exceso de frío y la manteca endureció mucho.",{"type":258,"tag":268,"props":526,"children":527},{},[528],{"type":281,"value":529},"Como referencia, la masa debería sentirse bastante helada pero, algo trabajable y estirable al mismo tiempo. Si hay exceso de frío, se puede descansar un poquito a temperatura ambiente y ahí proceder a estirarla.",{"type":258,"tag":268,"props":531,"children":532},{},[533],{"type":281,"value":534},"Te puede pasar como a mí que la heladera no llegar a darle ese frío necesario y podes usar el freezer para llegar a ese punto justo.",{"type":258,"tag":268,"props":536,"children":537},{},[538],{"type":281,"value":539},"Este proceso de estirado y dar vueltas la masa (hojaldrado) se sugiere hacer 2 vueltas doble, 2 veces.",{"type":258,"tag":268,"props":541,"children":542},{},[543,549],{"type":258,"tag":272,"props":544,"children":548},{"className":545,"width":276,"height":276,"src":546,"alt":547},[275],"data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2232%22 height=%2232%22 fill=%22none%22 viewBox=%220 0 32 32%22%3E%3Cpath fill=%22%23FFB02E%22 d=%22m14.839 5.668-12.66 21.93c-.51.89.13 2.01 1.16 2.01h25.32c1.03 0 1.67-1.11 1.16-2.01l-12.66-21.93c-.52-.89-1.8-.89-2.32 0Z%22/%3E%3Cpath fill=%22%23000%22 d=%22M14.599 21.497a1.4 1.4 0 1 0 2.8-.01v-9.16c0-.77-.62-1.4-1.4-1.4-.77 0-1.4.62-1.4 1.4v9.17Zm2.8 3.98a1.4 1.4 0 1 1-2.8 0 1.4 1.4 0 0 1 2.8 0Z%22/%3E%3C/svg%3E","⚠️",[],{"type":281,"value":550}," Nota IMPORTANTE: luego de realizado todo el proceso de hojaldrado, NO DEJAR por más que el tiempo mencionado en la heladera: entre 1hs y 2hs. Yo solía hacer la masa a la noche, terminar todo el hojaldrado y dejarla hasta el otro día en la heladera para despertar y hacer el resto de los pasos. Pero en todas esas horas la masa empieza a leudar en la heladera y las cosas no salen bien.",{"type":258,"tag":268,"props":552,"children":553},{},[554],{"type":281,"value":555},"Así que respetar esos tiempos y no dejar las cosas de más.",{"type":258,"tag":377,"props":557,"children":558},{"id":207},[559],{"type":281,"value":208},{"type":258,"tag":336,"props":561,"children":562},{},[563,582],{"type":258,"tag":340,"props":564,"children":565},{},[566,568,573,575,580],{"type":281,"value":567},"En una cacerola colocamos toda ",{"type":258,"tag":328,"props":569,"children":570},{"ingredient":211},[571],{"type":281,"value":572},"la leche",{"type":281,"value":574}," y ",{"type":258,"tag":328,"props":576,"children":577},{"ingredient":219,"allocation":222},[578],{"type":281,"value":579},"la mitad del azúcar",{"type":281,"value":581}," de los ingredientes.",{"type":258,"tag":340,"props":583,"children":584},{},[585],{"type":281,"value":586},"Llevar la cacerola a un fuego medio",{"type":258,"tag":268,"props":588,"children":589},{},[590,596],{"type":258,"tag":272,"props":591,"children":595},{"className":592,"width":276,"height":276,"src":593,"alt":594},[275],"data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2232%22 height=%2232%22 fill=%22none%22 viewBox=%220 0 32 32%22%3E%3Cpath fill=%22%2300A6ED%22 d=%22M18.5 29.041h-5.02C7.69 29.041 3 24.351 3 18.561v-4.9h25.98v4.9c0 5.79-4.69 10.48-10.48 10.48Z%22/%3E%3Cpath fill=%22%2326EAFC%22 d=%22M21.55 6.231H10.43c-4.1 0-7.43 3.33-7.43 7.43s3.33 7.43 7.43 7.43h11.12c4.1 0 7.43-3.33 7.43-7.43s-3.32-7.43-7.43-7.43Z%22/%3E%3Cpath fill=%22%230074BA%22 d=%22M21.865 7.871c3.1 0 5.626 2.6 5.626 5.79s-2.527 5.79-5.626 5.79h-2.51l-4.51-1.857-4.51 1.857h-.111c-3.1 0-5.626-2.6-5.626-5.79s2.526-5.79 5.626-5.79h11.64Z%22/%3E%3Cpath fill=%22%23D3D3D3%22 d=%22m26.393 3.05-7.161 12.194a2.433 2.433 0 0 0-.16 2.104c.24.632.343 1.35.303 2.103h-9.062c.152-.419.347-.835.585-1.242 1.048-1.784 2.68-2.925 4.268-3.163a2.42 2.42 0 0 0 1.756-1.158L24.1 1.665a1.333 1.333 0 0 1 1.866-.442c.617.393.79 1.207.427 1.826Z%22/%3E%3Cpath fill=%22%239B9B9B%22 d=%22M11.48 19.451h6.725c0-1.179-.476-2.217-1.383-2.75-1.555-.913-3.792.006-4.994 2.054-.134.229-.25.462-.348.696Z%22/%3E%3C/svg%3E","🥣",[],{"type":281,"value":597}," En otro bowl:",{"type":258,"tag":336,"props":599,"children":600},{"start":116},[601,625],{"type":258,"tag":340,"props":602,"children":603},{},[604,606,611,613,618,619,624],{"type":281,"value":605},"Colocar ",{"type":258,"tag":328,"props":607,"children":608},{"ingredient":229},[609],{"type":281,"value":610},"el almidón de maiz",{"type":281,"value":612},", ",{"type":258,"tag":328,"props":614,"children":615},{"ingredient":232},[616],{"type":281,"value":617},"harina",{"type":281,"value":574},{"type":258,"tag":328,"props":620,"children":621},{"ingredient":219,"allocation":226},[622],{"type":281,"value":623},"el restante del azúcar",{"type":281,"value":301},{"type":258,"tag":340,"props":626,"children":627},{},[628,630,635],{"type":281,"value":629},"Agregamos ",{"type":258,"tag":328,"props":631,"children":632},{"ingredient":235},[633],{"type":281,"value":634},"los huevos",{"type":281,"value":636}," y mezclamos",{"type":258,"tag":268,"props":638,"children":639},{},[640,644],{"type":258,"tag":272,"props":641,"children":643},{"className":642,"width":276,"height":276,"src":71,"alt":70},[275],[],{"type":281,"value":645}," Con la leche ya caliente de la cacerola:",{"type":258,"tag":336,"props":647,"children":648},{"start":448},[649,654,659,664,669,674],{"type":258,"tag":340,"props":650,"children":651},{},[652],{"type":281,"value":653},"Agregamos un poco de la leche al bowl, y mezclamos",{"type":258,"tag":340,"props":655,"children":656},{},[657],{"type":281,"value":658},"Toda la preparación del bowl la vertimos en la cacerola",{"type":258,"tag":340,"props":660,"children":661},{},[662],{"type":281,"value":663},"Mezclamos y llevamos a un fuego medio sin parar de revolver",{"type":258,"tag":340,"props":665,"children":666},{},[667],{"type":281,"value":668},"Una vez que la preparación rompe el hervor cocinamos por un minuto más sin dejar de revolver",{"type":258,"tag":340,"props":670,"children":671},{},[672],{"type":281,"value":673},"Apagamos el fuego y agregamos esencia de vainilla. Mezclamos.",{"type":258,"tag":340,"props":675,"children":676},{},[677],{"type":281,"value":678},"Colocar la mezcla en otro bowl. Cubrir con papel film. Esperar que se enfríe un poco y llevar luego a la heladera.",{"type":258,"tag":377,"props":680,"children":682},{"id":681},"preparar-las-formas-de-las-facturas",[683],{"type":281,"value":684},"Preparar las formas de las facturas",{"type":258,"tag":268,"props":686,"children":687},{},[688],{"type":281,"value":689},"Con la masa descansada de heladera:",{"type":258,"tag":336,"props":691,"children":692},{},[693],{"type":258,"tag":340,"props":694,"children":695},{},[696,698,704],{"type":281,"value":697},"Estirar la masa. Que no sea quede muy gruesa. ",{"type":258,"tag":397,"props":699,"children":701},{"className":700},[],[702],{"type":281,"value":703},"3-4mm",{"type":281,"value":705}," de espesor.",{"type":258,"tag":268,"props":707,"children":708},{},[709],{"type":281,"value":710},"Si la masa quedó muy fría, tener la precaución de esperar un poco para que pueda ser estirada sin problemas.",{"type":258,"tag":336,"props":712,"children":713},{"start":95},[714],{"type":258,"tag":340,"props":715,"children":716},{},[717,719,725],{"type":281,"value":718},"Armar las facturas. De nuevo, ir al video de referencia. Minuto ",{"type":258,"tag":397,"props":720,"children":722},{"className":721},[],[723],{"type":281,"value":724},"28:00",{"type":281,"value":301},{"type":258,"tag":268,"props":727,"children":728},{},[729],{"type":281,"value":730},"Varias de las formas son rectángulos de 9x3cm.",{"type":258,"tag":268,"props":732,"children":733},{},[734],{"type":281,"value":735},"Ir armándolas y dejarlas en la bandeja que irá al horno. No es necesario enmantecar la bandeja, dada la cantidad de manteca que lleva ya la masa.",{"type":258,"tag":336,"props":737,"children":738},{"start":116},[739],{"type":258,"tag":340,"props":740,"children":741},{},[742],{"type":281,"value":743},"Tapar con papel film y dejarlos leudar a temperatura ambiente por aprox 1hs - 1hs30min.",{"type":258,"tag":377,"props":745,"children":746},{"id":153},[747],{"type":281,"value":154},{"type":258,"tag":336,"props":749,"children":750},{},[751],{"type":258,"tag":340,"props":752,"children":753},{},[754],{"type":281,"value":755},"Mezclar los ingredientes y listo.",{"type":258,"tag":377,"props":757,"children":759},{"id":758},"luego-del-descanso-final",[760],{"type":281,"value":761},"Luego del descanso final",{"type":258,"tag":336,"props":763,"children":764},{},[765,770,775,780,785],{"type":258,"tag":340,"props":766,"children":767},{},[768],{"type":281,"value":769},"Poner el horno a precalentar a 190º por 15 minutos. Es medio-alto en un horno de casa.",{"type":258,"tag":340,"props":771,"children":772},{},[773],{"type":281,"value":774},"Pincelar con la doradura sobre todas las facturas.",{"type":258,"tag":340,"props":776,"children":777},{},[778],{"type":281,"value":779},"Colocar los membrillos y cremas sobre las facturas. Si querías hacer sacramentos, pues bueno, el membrillo iba en el proceso anterior ya :)",{"type":258,"tag":340,"props":781,"children":782},{},[783],{"type":281,"value":784},"Llevar al horno",{"type":258,"tag":340,"props":786,"children":787},{},[788],{"type":281,"value":789},"Cuando estén bien doradas, es sinónimo de que ya están listas",{"type":258,"tag":268,"props":791,"children":792},{},[793],{"type":281,"value":794},"Por mientras se cocinan en el horno, hacemos el almíbar",{"type":258,"tag":377,"props":796,"children":798},{"id":797},"almíbar",[799],{"type":281,"value":178},{"type":258,"tag":268,"props":801,"children":802},{},[803,805,810],{"type":281,"value":804},"Aporta una humedad y sabor ",{"type":258,"tag":295,"props":806,"children":807},{},[808],{"type":281,"value":809},"muy importantes",{"type":281,"value":811}," a las facturas.",{"type":258,"tag":268,"props":813,"children":814},{},[815],{"type":281,"value":816},"La miel ayuda a que no se formen cristales (esos granitos de azúcar) en la preparación del almíbar. También aportará mucho brillo en las facturas.",{"type":258,"tag":336,"props":818,"children":819},{},[820,825,830],{"type":258,"tag":340,"props":821,"children":822},{},[823],{"type":281,"value":824},"Colocar los ingredientes en una olla a fuego medio. Mezclar.",{"type":258,"tag":340,"props":826,"children":827},{},[828],{"type":281,"value":829},"Cuando rompa el hervor, poner a fuego mínimo por 5 minutos",{"type":258,"tag":340,"props":831,"children":832},{},[833],{"type":281,"value":834},"Retirar",{"type":258,"tag":268,"props":836,"children":837},{},[838],{"type":281,"value":839},"A este punto, hay que esperar que salgan las facturas del horno. Dejarlas que se enfrien solo un poquito, que queden tibias. Y ahí aplicar el almíbar. Si no, absorberá mucho almíbar y quedarán muy pesadas (a algunos les gusta que sean así).",{"title":7,"searchDepth":95,"depth":95,"links":841},[842],{"id":138,"depth":116,"text":139},"markdown","content:recetas:facturas.md","content","recetas/facturas.md","recetas/facturas","md",1792126626671]