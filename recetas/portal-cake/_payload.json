":134},[273],{"type":227,"value":274},"el azúcar",{"type":227,"value":276},", revolviendo de tanto en tanto.",{"type":213,"tag":258,"props":278,"children":279},{},[280],{"type":227,"value":281},"Cocinar hasta que los frutos se deshagan y se forme una salsa homogénea.",{"type":213,"tag":258,"props":283,"children":284},{},[285],{"type":227,"value":286},"Colar la preparación, separando el líquido (jugo) de la parte sólida.",{"type":213,"tag":229,"props":288,"children":289},{},[290,292,298,300,305],{"type":227,"value":291},"De este colado se obtienen dos cosas: el ",{"type":213,"tag":293,"props":294,"children":295},"strong",{},[296],{"type":227,"value":297},"jugo",{"type":227,"value":299},", que se usa para el bizcochuelo y como almíbar de armado, y la ",{"type":213,"tag":293,"props":301,"children":302},{},[303],{"type":227,"value":304},"fruta colada",{"type":227,"value":306},", que se usa como relleno entre capas. Si sobra jugo, se puede guardar para servir a un costado de cada porción.",{"type":213,"tag":223,"props":308,"children":309},{"id":39},[310],{"type":227,"value":40},{"type":213,"tag":254,"props":312,"children":313},{},[314,319,351,368,386,404,409,414],{"type":213,"tag":258,"props":315,"children":316},{},[317],{"type":227,"value":318},"Precalentar el horno a 180°C.",{"type":213,"tag":258,"props":320,"children":321},{},[322,324,329,331,336,337,342,344,349],{"type":227,"value":323},"En un bowl, tamizar juntos ",{"type":213,"tag":235,"props":325,"children":326},{"ingredient":43},[327],{"type":227,"value":328},"la harina",{"type":227,"value":330},", ",{"type":213,"tag":235,"props":332,"children":333},{"ingredient":55},[334],{"type":227,"value":335},"el cacao",{"type":227,"value":330},{"type":213,"tag":235,"props":338,"children":339},{"ingredient":92},[340],{"type":227,"value":341},"el bicarbonato",{"type":227,"value":343}," y ",{"type":213,"tag":235,"props":345,"children":346},{"ingredient":96},[347],{"type":227,"value":348},"la sal",{"type":227,"value":350},".",{