ura)",{"type":213,"tag":254,"props":426,"children":427},{},[428,451],{"type":213,"tag":258,"props":429,"children":430},{},[431,433,438,439,444,445,449],{"type":227,"value":432},"Batir ",{"type":213,"tag":235,"props":434,"children":435},{"ingredient":140},[436],{"type":227,"value":437},"la crema de leche bien fría",{"type":227,"value":241},{"type":213,"tag":235,"props":440,"children":441},{"ingredient":145},[442],{"type":227,"value":443},"el azúcar impalpable",{"type":227,"value":343},{"type":213,"tag":235,"props":446,"children":447},{"ingredient":149},[448],{"type":227,"value":335},{"type":227,"value":450}," hasta llegar a picos suaves-medios.",{"type":213,"tag":258,"props":452,"children":453},{},[454,455,460],{"type":227,"value":372},{"type":213,"tag":235,"props":456,"children":457},{"ingredient":158},[458],{"type":227,"value":459},"el licor de almendras y chocolate",{"type":227,"value":461},", y seguir batiendo hasta lograr picos firmes. No pasarse de batido.",{"type":213,"tag":223,"props":463,"children":465},{"id":464},"chantilly-blanca-decoración",[466],{"type":227,"value":467},"Chantilly blanca (decoración)",{"type":213,"tag":229,"props":469,"children":470},{},[471,472,477,478,482],{"type":227,"value":432},{"type":213,"tag":235,"props":473,"children":474},{"ingredient":175},[475],{"type":227,"value":476},"la crema de leche",{"type":227,"value":241},{"type":213,"tag":235,"props":479,"children":480},{"ingredient":178},[481],{"type":227,"value":274},{"type":227,"value":483}," y la esencia de vainilla hasta lograr picos firmes. Reservar en frío hasta el armado final.",{"type":213,"tag":223,"props":485,"children":487},{"id":486},"chocolate-rallado",[488],{"type":227,"value":489},"Chocolate rallado",{"type":213,"tag":229,"props":491,"children":492},{},[493,495,500],{"type":227,"value":494},"Con un cuchillo, rallar ",{"type":213,"tag":235,"props":496,"children":497},{"ingredient":166},[498],{"type":227,"value":499},"el chocolate semiamargo",{"type":227,"value":501}," 