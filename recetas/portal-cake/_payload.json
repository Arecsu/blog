enodd%22 d=%22M15 23.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Zm15.03 0a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z%22 clip-rule=%22evenodd%22/%3E%3C/svg%3E","🍒",[],{"type":29,"value":384}," Cerezas al marraschino (sin cadete)",{"type":15,"tag":20,"props":386,"children":388},{"name":387},"Etc",[389],{"type":15,"tag":36,"props":390,"children":391},{},[392,397,402,407],{"type":15,"tag":40,"props":393,"children":394},{},[395],{"type":29,"value":396},"Colador tamizador",{"type":15,"tag":40,"props":398,"children":399},{},[400],{"type":29,"value":401},"Pincel de cocina",{"type":15,"tag":40,"props":403,"children":404},{},[405],{"type":29,"value":406},"Manga o cuchara para los picos de chantilly",{"type":15,"tag":40,"props":408,"children":409},{},[410],{"type":29,"value":411},"Cuchillo para rallar el chocolate",{"type":15,"tag":413,"props":414,"children":416},"recipe-process",{":process":415},"true",[417,423,428,433,452,472,477,520,526,539,545,550,556,561,567,572,577,613,618,624],{"type":15,"tag":418,"props":419,"children":421},"h3",{"id":420},"buttermilk",[422],{"type":29,"value":33},{"type":15,"tag":25,"props":424,"children":425},{},[426],{"type":29,"value":427},"Mezclar la leche entera con el jugo de limón o vinagre. Dejar reposar 10-15 minutos hasta que se corte levemente. Reservar.",{"type":15,"tag":418,"props":429,"children":431},{"id":430},"salsa-de-frutos-rojos",[432],{"type":29,"value":227},{"type":15,"tag":434,"props":435,"children":436},"ol",{},[437,442,447],{"type":15,"tag":40,"props":438,"children":439},{},[440],{"type":29,"value":441},"Calentar en una olla los frutos rojos congelados junto con el azúcar, revolviendo de tanto en tanto.",{"type":15,"tag":40,"props":443,"children":444},{},[445],{"type":29,"value":446},"Cocinar hasta que los frutos se deshagan y se forme una salsa homogénea.",{"type":15,"tag":40,"props":448,"children":449},{},[450],{"type":29,"value":451},"Colar la preparación, separando el líquido (jugo) de la parte sólida.",{"type":15,"tag":25,"props":453,"children":454},{},[455,457,463,465,470],{"type":29,"value":456},"De este colado se obtienen dos cosas: el ",{"type":15,"tag":458,"props":459,"children":460},"strong",{},[461],{"type":29,"value":462},"jugo",{"type":29,"value":464},", que se usa para el bizcochuelo y como almíbar de armado, y la ",{"type":15,"tag":458,"props":466,"children":467},{},[468],{"type":29,"value":469},"fruta colada",{"type":29,"value":471},", que se usa como relleno entre capas. Si sobra jugo, se puede guardar para servir a un costado de cada porción.",{"type":15,"tag":418,"props":473,"children":475},{"id":474},"bizcochuelo",[476],{"type":29,"value":76},{"type":15,"tag":434,"props":478,"children":479},{},[480,485,490,495,500,505,510,515],{"type":15,"tag":40,"props":481,"children":482},{},[483],{"type":29,"value":484},"Precalentar el horno a 180°C.",{"type":15,"tag":40,"props":486,"children":487},{},[488],{"type":29,"value":489},"En un bowl, tamizar juntos la harina, el cacao, el bicarbonato y la sal.",{"type":15,"tag":40,"props":491,"children":492},{},[493],{"type":29,"value":494},"En otro bowl, batir la manteca con el azúcar hasta que quede cremosa.",{"type":15,"tag":40,"props":496,"children":497},{},[498],{"type":29,"value":499},"Agregar los huevos de a uno, batiendo bien después de cada uno, y luego la esencia de vainilla.",{"type":15,"tag":40,"props":501,"children":502},{},[503],{"type":29,"value":504},"Incorporar los secos tamizados alternando con el buttermilk y los 120 gr de jugo de frutos rojos, en 3 tandas, empezando y terminando con los secos. Mezclar solo hasta integrar.",{"type":15,"tag":40,"props":506,"children":507},{},[508],{"type":29,"value":509},"Dividir la masa en 3 moldes iguales (o cocinar en tandas con un mismo molde).",{"type":15,"tag":40,"props":511,"children":512},{},[513],{"type":29,"value":514},"Hornear 20-25 minutos, o hasta que un palillo salga limpio.",{"type":15,"tag":40,"props":516,"children":517},{},[518],{"type":29,"value":519},"Dejar enfriar por completo antes de armar.",{"type":15,"tag":418,"props":521,"children":523},{"id":522},"chantilly-de-cacao-relleno-y-cobertura",[524],{"type":29,"value":525},"Chantilly de cacao (relleno y cobertura)",{"type":15,"tag":434,"props":527,"children":528},{},[529,534],{"type":15,"tag":40,"props":530,"children":531},{},[532],{"type":29,"value":533},"Batir la crema de leche bien fría con el azúcar impalpable y el cacao hasta llegar a picos suaves-medios.",{"type":15,"tag":40,"props":535,"children":536},{},[537],{"type":29,"value":538},"Agregar el licor de almendras y chocolate, y seguir batiendo hasta lograr picos firmes. No pasarse de batido.",{"type":15,"tag":418,"props":540,"children":542},{"id":541},"chantilly-blanca-decoración",[543],{"type":29,"value":544},"Chantilly blanca (decoración)",{"type":15,"tag":25,"props":546,"children":547},{},[548],{"type":29,"value":549},"Batir la crema de leche con el azúcar y la esencia de vainilla hasta lograr picos firmes. Reservar en frío hasta el armado final.",{"type":15,"tag":418,"props":551,"children":553},{"id":552},"chocolate-rallado",[554],{"type":29,"value":555},"Chocolate rallado",{"type":15,"tag":25,"props":557,"children":558},{},[559],{"type":29,"value":560},"Con un cuchillo, rallar el chocolate semiamargo (frío o congelado) en ángulo de 45-60°, generando virutas tipo aserrín. Reservar en frío.",{"type":15,"tag":418,"props":562,"children":564},{"id":563},"armado",[565],{"type":29,"value":566},"Armado",{"type":15,"tag":25,"props":568,"children":569},{},[570],{"type":29,"value":571},"Con un tenedor, pinchar suavemente toda la superficie de cada capa de bizcochuelo y humedecer con el jugo de frutos rojos.",{"type":15,"tag":25,"props":573,"children":574},{},[575],{"type":29,"value":576},"Desde la base hacia arriba:",{"type":15,"tag":434,"props":578,"children":579},{},[580,585,590,595,600,604,608],{"type":15,"tag":40,"props":581,"children":582},{},[583],{"type":29,"value":584},"Capa de bizcochuelo (base) → humedecer",{"type":15,"tag":40,"props":586,"children":587},{},[588],{"type":29,"value":589},"Chantilly de cacao",{"type":15,"tag":40,"props":591,"children":592},{},[593],{"type":29,"value":594},"Salsa de frutos rojos (la parte sólida colada)",{"type":15,"tag":40,"props":596,"children":597},{},[598],{"type":29,"value":599},"Capa de bizcochuelo → humedecer",{"type":15,"tag":40,"props":601,"children":602},{},[603],{"type":29,"value":589},{"type":15,"tag":40,"props":605,"children":606},{},[607],{"type":29,"value":227},{"type":15,"tag":40,"props":609,"children":610},{},[611],{"type":29,"value":612},"Capa de bizcochuelo (tapa) → humedecer",{"type":15,"tag":25,"props":614,"children":615},{},[616],{"type":29,"value":617},"Cubrir toda la torta (parte superior y laterales) con el resto de la chantilly de cacao.",{"type":15,"tag":418,"props":619,"children":621},{"id":620},"decoración-final",[622],{"type":29,"value":623},"Decoración final",{"type":15,"tag":434,"props":625,"children":626},{},[627,632,637],{"type":15,"tag":40,"props":628,"children":629},{},[630],{"type":29,"value":631},"Esparcir el chocolate rallado sobre toda la cobertura de la torta.",{"type":15,"tag":40,"props":633,"children":634},{},[635],{"type":29,"value":636},"Con la chantilly blanca, formar 8 picos en círculo sobre el borde superior de la torta.",{"type":15,"tag":40,"props":638,"children":639},{},[640],{"type":29,"value":641},"Coronar cada pico con una cereza al marraschino.",{"title":7,"searchDepth":643,"depth":643,"links":644},2,[645,647,648,649,650,651,652,653],{"id":420,"depth":646,"text":33},3,{"id":430,"depth":646,"text":227},{"id":474,"depth":646,"text":76},{"id":522,"depth":646,"text":525},{"id":541,"depth":646,"text":544},{"id":552,"depth":646,"text":555},{"id":563,"depth":646,"text":566},{"id":620,"depth":646,"text":623},"markdown","content:recetas:portal-cake.md","content","recetas/portal-cake.md","recetas/portal-cake","md",{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"icon":9,"alt":10,