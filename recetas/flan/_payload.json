[{"data":1,"prerenderedAt":228},["ShallowReactive",2],{"recipe-flan":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":9,"icon":10,"cover":11,"alt":8,"inlineAmounts":15,"ingredientGroups":16,"body":66,"_type":222,"_id":223,"_source":224,"_file":225,"_stem":226,"_extension":227},"/recetas/flan","recetas",false,"","Flan","Esencia de vainilla real y muchas yemas 🍮","fluent-emoji:custard",{"file":12,"width":13,"height":14},"flan.jpg",2000,1500,true,[17,60],{"id":18,"label":8,"items":19},"flan",[20,32,43,51,56],{"id":21,"label":22,"quantity":23,"unit":24,"labelParts":25},"milk","Leche",1,"litro",[26,30],{"emoji":27},{"alt":28,"src":29},"🥛","data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2232%22 height=%2232%22 fill=%22none%22 viewBox=%220 0 32 32%22%3E%3Cpath fill=%22%23AEDDFF%22 d=%22m4.01 3.066 3.78 26.127a.95.95 0 0 0 .937.807h14.546a.934.934 0 0 0 .937-.807l3.78-26.127A.942.942 0 0 0 27.053 2H4.947a.942.942 0 0 0-.938 1.066Z%22/%3E%3Cpath fill=%22%23F3EEF8%22 d=%22m6.51 9.295 2.461 17.167c.04.309.31.538.62.538h12.806c.31 0 .58-.229.62-.538l2.47-17.167c.1-.688-.43-1.295-1.13-1.295H7.64c-.69 0-1.22.617-1.13 1.295Z%22/%3E%3Cpath fill=%22%23fff%22 d=%22M24.856 5.215a1 1 0 1 0-1.98-.284L19.713 27h2.02l3.123-21.785Z%22/%3E%3C/svg%3E",{"text":31}," Leche",{"id":33,"label":34,"quantity":35,"whole":15,"labelParts":36},"eggs","Huevos completos",6,[37,41],{"emoji":38},{"alt":39,"src":40},"🥚","data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2232%22 height=%2232%22 fill=%22none%22 viewBox=%220 0 32 32%22%3E%3Cpath fill=%22%23F3AD61%22 d=%22M16.331 2c-2.57 0-4.98 1.28-6.42 3.4l-.13.19A21.923 21.923 0 0 0 6.101 20l.08.8c.5 5.21 4.88 9.18 10.11 9.18 5.25 0 9.63-3.99 10.11-9.22l.09-.93a21.9 21.9 0 0 0-3.78-14.48A7.772 7.772 0 0 0 16.331 2Z%22/%3E%3C/svg%3E",{"text":42}," Huevos completos",{"id":44,"label":45,"quantity":35,"whole":15,"labelParts":46},"yolks","Yemas",[47,49],{"emoji":48},{"alt":39,"src":40},{"text":50}," Yemas",{"id":52,"label":53,"quantity":54,"unit":55},"sugar","Azúcar blanca",250,"g",{"id":57,"label":58,"amount":59},"vanilla","Esencia de Vainilla","A ojo",{"id":61,"label":62,"items":63},"caramelo","Caramelo",[64],{"id":65,"label":53,"amount":59},"caramel-sugar",{"type":67,"children":68,"toc":217},"root",[69,74],{"type":70,"tag":71,"props":72,"children":73},"element","recipe-ingredients",{},[],{"type":70,"tag":75,"props":76,"children":78},"recipe-process",{":process":77},"true",[79,124,130,146,151,156,161,166,171,176,181,187,192,197,202,207,212],{"type":70,"tag":80,"props":81,"children":82},"ol",{},[83,111],{"type":70,"tag":84,"props":85,"children":86},"li",{},[87,90,96,98,103,104,109],{"type":88,"value":89},"text","Mezclar ",{"type":70,"tag":91,"props":92,"children":93},"recipe-amount",{"ingredient":33},[94],{"type":88,"value":95},"los huevos completos",{"type":88,"value":97}," + ",{"type":70,"tag":91,"props":99,"children":100},{"ingredient":44},[101],{"type":88,"value":102},"las yemas extras",{"type":88,"value":97},{"type":70,"tag":91,"props":105,"children":106},{"ingredient":52},[107],{"type":88,"value":108},"el azúcar",{"type":88,"value":110},".",{"type":70,"tag":84,"props":112,"children":113},{},[114,116,122],{"type":88,"value":115},"Revolver con el ",{"type":70,"tag":117,"props":118,"children":119},"strong",{},[120],{"type":88,"value":121},"batidor",{"type":88,"value":123}," francés solo un poco, muy despacio para no meter aire en la mezcla y asi evitar agujeritos y grumos en la cocción. Que los alambres pasen entre los huevos simplemente.",{"type":70,"tag":125,"props":126,"children":127},"p",{},[128],{"type":88,"value":129},"La mezcla tiene que estar líquida, que no tenga estructura fuerte. Levantar el batidor francés para comprobarlo.",{"type":70,"tag":80,"props":131,"children":133},{"start":132},3,[134],{"type":70,"tag":84,"props":135,"children":136},{},[137,139,144],{"type":88,"value":138},"En otro bowl, mezclar la esencia de vainilla (buena cantidad) con ",{"type":70,"tag":91,"props":140,"children":141},{"ingredient":21},[142],{"type":88,"value":143},"la leche",{"type":88,"value":145},". La leche tiene que estar fría. Se puede hacer con leche caliente para ahorrar tiempo de cocción pero la técnica es más complicada.",{"type":70,"tag":147,"props":148,"children":149},"h3",{"id":61},[150],{"type":88,"value":62},{"type":70,"tag":125,"props":152,"children":153},{},[154],{"type":88,"value":155},"Usar una sartén. Poner el fuego fuerte al principio. Azúcar común, no mucho, ponerle sobre la sartén.",{"type":70,"tag":125,"props":157,"children":158},{},[159],{"type":88,"value":160},"Ahora, a esperar que se ponga de sólida a líquida. En el lugar donde se va fundiendo hay que agregar azúcar de a poquito. La idea es bajar la temperatura con la nueva azúcar que se le va agregando en los sectores donde el azúcar en la sartén se está quemando.",{"type":70,"tag":125,"props":162,"children":163},{},[164],{"type":88,"value":165},"Hay que tener paciencia.",{"type":70,"tag":125,"props":167,"children":168},{},[169],{"type":88,"value":170},"Despues de tres-cuatro pasadas, revolver con una cuchara de madera un poquito y esperar que se funda completamente.",{"type":70,"tag":125,"props":172,"children":173},{},[174],{"type":88,"value":175},"Una vez fundido, ponerle más azúcar. Cuanta cantidad? Menos cantidad que la que hay en la sartén, para evitar que la temperatura baje demasiado. De nuevo, de a poco. Y revolver.",{"type":70,"tag":125,"props":177,"children":178},{},[179],{"type":88,"value":180},"¿Cuanto caramelo hacer? Cantidad necesaria.",{"type":70,"tag":147,"props":182,"children":184},{"id":183},"al-molde",[185],{"type":88,"value":186},"Al molde",{"type":70,"tag":125,"props":188,"children":189},{},[190],{"type":88,"value":191},"Una vez que todo el caramelo esté fundido, volcar sobre el molde. Si es un molde de esos baratos de aluminio, volcar sobre la base y agarrar el molde con un trapo con las dos manos y moverlo para que el caramelo trepe en todas las paredes del molde.",{"type":70,"tag":125,"props":193,"children":194},{},[195],{"type":88,"value":196},"Luego, tamizar la preparación del flan y volcarlo sobre el caramelo.",{"type":70,"tag":125,"props":198,"children":199},{},[200],{"type":88,"value":201},"Baño maría en un molde similar al de la preparación del flan a la altura de donde quedó el flan, puede ser un poquito menos.",{"type":70,"tag":125,"props":203,"children":204},{},[205],{"type":88,"value":206},"Horno a temperatura muy baja. Alrededor de una hora a 150 grados.",{"type":70,"tag":125,"props":208,"children":209},{},[210],{"type":88,"value":211},"La forma de darse cuenta si un flan está listo es acercarse al horno, atravesar el flan con un cuchillo, y el cuchillo tiene que salir completamente limpio. Si no, le falta tiempo de cocción.",{"type":70,"tag":125,"props":213,"children":214},{},[215],{"type":88,"value":216},"Dejarlo enfriar a temperatura ambiente. Recomendado dejarlo un día antes de comerlo. Estas preparaciones se ponen mejores luego de pasados los días.",{"title":7,"searchDepth":218,"depth":218,"links":219},2,[220,221],{"id":61,"depth":132,"text":62},{"id":183,"depth":132,"text":186},"markdown","content:recetas:flan.md","content","recetas/flan.md","recetas/flan","md",1792126626671]