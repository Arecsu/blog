---
import { getCollection, render } from "astro:content"
import Base from "@layouts/Base.astro"
import Icon from "@components/Icon.svelte"
import RecipeIngredients from "@components/Recipe/RecipeIngredients.svelte"
import RecipeProcess from "@components/Recipe/RecipeProcess.svelte"
import RecipeAmount from "@components/Recipe/RecipeAmount.astro"
import RecipeSidebar from "@components/Recipe/RecipeSidebar.astro"
import RecipeSubingredient from "@components/Recipe/RecipeSubingredient.astro"
import { recipeIcon } from "@components/icons.ts"
import { recipeTitleWidth, validateRecipeIngredients } from "@lib/recipe.ts"
import { sanitizeRecipeGroups } from "@lib/recipe-content.ts"
import titleMetrics from "@lib/recipe-title-metrics.json"

export async function getStaticPaths() {
	const recetas = await getCollection("recetas")
	return recetas
		.filter((entry) => (import.meta.env.PROD ? !entry.data.draft : true))
		.map((entry) => ({
			params: { slug: entry.id },
			props: { entry },
		}))
}

const { entry } = Astro.props
const groups = sanitizeRecipeGroups(validateRecipeIngredients(entry.data.ingredientGroups ?? []))
const { Content } = await render(entry)
const extras = await getCollection("recipeExtras")
const extra = extras.find((extra) => extra.id === entry.id)
const ExtraContent = extra ? (await render(extra)).Content : undefined
const IconComponent = recipeIcon(entry.data.icon)
const title = entry.data.title
const titleWidth = recipeTitleWidth(title, Boolean(IconComponent), titleMetrics)
const token = crypto.randomUUID()
const recipeData = {
	id: entry.id,
	title,
	groups,
	inlineAmounts: entry.data.inlineAmounts,
}
const hasProcess = Boolean(entry.body?.trim())
const components = { RecipeAmount, RecipeSubingredient }
// <RecipeAmount> components in the MDX body resolve against these groups.
Astro.locals.recipe = { groups }
---

<Base title={title.toLowerCase()} headerTitle={title.toLowerCase()} lang="es">
	<div class="recipe-layout">
		<RecipeSidebar title={title} />
		<div class="recipe-container">
			<h1 class="recipe-title" style={`--recipe-title-width: ${titleWidth}`}>
				{IconComponent && (
					<Icon class="recipe-icon-title" marginInline="-0.02em 0.15em"><IconComponent /></Icon>
				)}{title}
			</h1>
			<div class="recipe">
				<RecipeIngredients client:load recipe={recipeData} token={token} hasExtra={Boolean(ExtraContent)}>
					{ExtraContent && <ExtraContent components={components} />}
				</RecipeIngredients>
				{
					hasProcess && (
						<RecipeProcess
							client:load
							recipe={recipeData}
							token={token}
							process={entry.data.process}
						>
							<Content components={components} />
						</RecipeProcess>
					)
				}
			</div>
		</div>
	</div>
</Base>

<style is:global lang="scss">
	.recipe-layout {
		--recipe-border: color-mix(in srgb, var(--color-text) 22%, transparent);
		--recipe-muted: color-mix(in srgb, var(--color-text) 72%, var(--color-bg-0));
		display: flex;
		flex-direction: row;

		button:focus-visible,
		input:focus-visible,
		select:focus-visible,
		summary:focus-visible,
		a:focus-visible {
			outline: 2px solid var(--color-subingredient-name);
			outline-offset: 3px;
		}
	}

	.recipe-layout,
	.recipe-container {
		width: 100%;
	}

	.recipe-sidebar-title,
	.recipe-title {
		font-family: var(--font-serif);
	}

	.recipe-container {
		display: flex;
		flex-direction: column;
		margin-top: 1rem;
		// The title measures itself against this column (cqi units).
		container-type: inline-size;
	}

	.recipe-icon-title {
		font-size: 0.9em;
		transform: translateY(-0.1em);
	}

	.recipe-title {
		// One line across the column: --recipe-title-width is the title's width in em (set
		// by the server, see recipeTitleWidth), so 100cqi / width fits it exactly. Never
		// larger than the usual size, and never below 2.5rem: a long title on a phone
		// wraps instead, in balanced lines.
		font-size: max(
			2.5rem,
			min(clamp(4em, 3em + 4vw, 8em), 100cqi / var(--recipe-title-width, 1))
		);
		text-wrap: balance;
		margin-bottom: 0.3em;
		font-weight: 500;
		letter-spacing: -0.05em;
		line-height: 1em;
		display: inline-block;
	}

	.recipe {
		display: grid;
		grid-template-areas:
			"three two"
			"three two";
		column-gap: 10rem;
		grid-template-columns: auto clamp(20rem, 0rem + 40vw, 56rem);
		align-self: flex-start;
		margin-bottom: 8rem;

		// Keep in sync with the sticky-ingredients query in RecipeIngredients.svelte.
		@media (max-width: $recipe-side-by-side) {
			grid-template-areas:
				"one"
				"two"
				"three";
			grid-template-columns: auto;
			row-gap: 2rem;
			align-self: stretch;
		}

		// Element defaults go in :where() so they weigh like a lone `.recipe`: any
		// component rule (`.subingredients ul`, `h5.recipe-subingredient-title`) beats
		// them whichever stylesheet comes last.
		:where(h1, h2, h3, h4, h5) {
			font-family: var(--font-serif);
			letter-spacing: -0.03em;
			font-weight: 400;
			line-height: 1.3;
			word-break: break-word;
		}

		:where(h1) {
			margin-block: 1.2em 0.6em;
			font-size: 5.653rem;
		}

		:where(h2) {
			margin-block: 1em 0.4em;
			font-size: clamp(1.8rem, 7vw, 4rem);

			// Trim the line box to the capitals so controls beside a title center on its
			// letters. Padding gives back what was trimmed (~.29em a side in Noto Serif),
			// so the layout matches browsers without text-box.
			@supports (text-box: trim-both cap alphabetic) {
				text-box: trim-both cap alphabetic;
				padding-block: 0.29em;
			}

			// Emoji stand on the baseline like the letters. Fluent emoji leave 2/32 of
			// blank space below the drawing, hence the extra nudge down.
			> .icon {
				vertical-align: calc(-2em / 32);
			}
		}

		:where(h3) {
			margin-block: 1.2em 0.5em;
			font-size: clamp(1.6rem, 7vw, 2.8rem);
		}

		:where(h4) {
			margin-block: 2em 0.5em;
			font-size: clamp(1.4rem, 7vw, 2rem);
		}

		:where(h5) {
			margin-block: 2.4em 1em;
			font-size: clamp(1.2rem, 7vw, 1.4rem);
		}

		:where(ul, ol) {
			padding-left: 2em;
		}

		:where(p) {
			margin-block: 1em;
		}
	}

	.recipe-process {
		h3,
		h4 {
			scroll-margin-top: calc(var(--header-height) + 1rem);
		}

		ul {
			list-style: none;
		}

		ul li {
			text-indent: -0.7em;

			&::before {
				content: "- ";
			}
		}

		ul li,
		ol li {
			margin-bottom: 0.8em;
		}

		.recipe-process-content > :first-child,
		.recipe-process-content > astro-slot > :first-child {
			margin-top: 0;
		}
	}

	.recipe-inline-ingredient {
		display: inline;
	}

	// The preference is applied to <html> by an inline head script before first
	// paint, so a refresh never flashes the chips in and reflows the prose. The
	// separating space is its own node and hides with the chip, otherwise hidden
	// amounts would leave a gap before punctuation ("levadura .").
	html[data-recipe-amounts="hidden"] .recipe-inline-amount,
	html[data-recipe-amounts="hidden"] .recipe-inline-space {
		display: none;
	}

	.recipe-inline-amount {
		display: inline;
		font: inherit;
		font-size: 0.88em;
		font-weight: 500;
		white-space: nowrap;
		// Little block padding: chips on consecutive lines of a paragraph must not touch.
		padding: 0.1em 0.35em;
		border: 0;
		border-radius: 0.2em;
		color: inherit;
		cursor: pointer;
		background: var(--color-bg-quantity-subingredient);
		text-decoration: underline transparent;
		text-underline-offset: 0.2em;

		&:hover {
			text-decoration-color: currentColor;
		}

		&[hidden] {
			display: none;
		}
	}

	// Placement, surface and shadow come from RecipePopover; this is only its content.
	.recipe-amount-popover {
		--recipe-popover-width: 20rem;
		font-size: 0.9rem;
		line-height: 1.6;

		> span,
		> div {
			display: block;
			margin-top: 0.4rem;
		}

		.recipe-amount-popover-heading {
			display: flex;
			justify-content: space-between;
			align-items: center;
			gap: 1rem;
			margin: 0;
		}

		button {
			display: grid;
			place-items: center;
			border: 0;
			background: none;
			color: inherit;
			min-width: 44px;
			min-height: 44px;
			padding: 0;
			font-size: 1.4rem;
			margin: -0.6rem -0.75rem -0.6rem 0;
		}

		.recipe-amount-group {
			color: var(--recipe-muted);
			font-size: 0.8rem;
		}
	}
</style>
